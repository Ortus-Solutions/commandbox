import java.io.FileOutputStream;
import java.lang.System;
import java.nio.file.Files;
import java.nio.file.Paths;

class {
	property name='packageService' inject='packageService';
	property name='semanticVersion' inject='provider:semanticVersion@semver';
	property name='progressableDownloader' inject='ProgressableDownloader';
	property name='artifactService' inject='ArtifactService';
	property name='installerBaseURL' default='https://downloads.ortussolutions.com/ortussolutions/boxlang-quick-installer';

	/**
	 * Packages the bx-cli module and its supporting Java libraries.
	 */
	function run() {
		var boxJSON = packageService.readPackageDescriptor( resolvePath( "bx-cli" ) );
		var moduleSrcPath = resolvePath( "bx-cli/src/system" );
		var repoSrcPath = resolvePath( "src/cfml/system" );
		if( directoryExists( moduleSrcPath ) ) {
			directoryDelete( moduleSrcPath, true );
		}
		directoryCreate( moduleSrcPath );
		directoryCopy( repoSrcPath, moduleSrcPath, true );
		command( "tokenReplace" ).params( moduleSrcPath & "Shell.cfc", "@build.version@", boxJSON.version, true ).run();
		command( "tokenReplace" ).params( moduleSrcPath & "Bootstrap.cfm", "@build.version@", boxJSON.version, true ).run();

		var libsPath = resolvePath( "bx-cli/libs" );
		if( directoryExists( libsPath ) ) {
			directoryDelete( libsPath, true );
		}
		directoryCreate( libsPath );

		command( "install" )
			.inWorkingDirectory( resolvePath( "bx-cli" ) )
			.flags( "!save", "force" )
			.run();

		compile()
			.fromSource( "src/java/com" )
			.toClasses( "build/temp/classes/jgit" )
			.withClassPath( [ resolvePath( "bx-cli/libs" ) ] )
			.toJar( "../bx-cli/libs/ortus-jgit.jar" )
			.run();

		command( "forgebox use" ).params( "ortus" ).run();
		command( "publish" ).inWorkingDirectory( resolvePath( "bx-cli" ) ).flags( "force" ).run();
	}

	/**

	* Builds the executable CLI launcher JAR.
	 */
	function buildCliJar( boolean installerSnapshot=true, boolean thin=false, string artifactName="box" ) {
		var classesPath = resolvePath( "build/temp/classes/cli-bootstrap" );
		var jarPath = resolvePath( "build/dist/#artifactName#.jar" );
		var installerResourcesPath = resolvePath( "build/temp/cli-bootstrap/installer" );
		var runtimeArtifactsPath = resolvePath( "build/temp/cli-bootstrap/runtime-artifacts" );
		var systemModulesPath = resolvePath( "build/temp/cli-bootstrap/system-modules" );
		var installerURLPrefix = installerSnapshot ? installerBaseURL & "/snapshot" : installerBaseURL;
		var installerURL = installerURLPrefix & "/boxlang-installer.zip";
		var boxLangURL = installerSnapshot
			? "https://downloads.ortussolutions.com/ortussolutions/boxlang/boxlang-snapshot.zip"
			: "https://downloads.ortussolutions.com/ortussolutions/boxlang/boxlang-latest.zip";
		var miniServerURL = installerSnapshot
			? "https://downloads.ortussolutions.com/ortussolutions/boxlang-runtimes/boxlang-miniserver/boxlang-miniserver-snapshot.zip"
			: "https://downloads.ortussolutions.com/ortussolutions/boxlang-runtimes/boxlang-miniserver/boxlang-miniserver-latest.zip";
		if( installerSnapshot ) {
			installerURL &= "?cacheBust=" & createUUID();
		}

		ensureBuildDirectories();
		if( directoryExists( classesPath ) ) {
			directoryDelete( classesPath, true );
		}
		if( directoryExists( installerResourcesPath ) ) {
			directoryDelete( installerResourcesPath, true );
		}
		if( directoryExists( runtimeArtifactsPath ) ) {
			directoryDelete( runtimeArtifactsPath, true );
		}
		if( directoryExists( systemModulesPath ) ) {
			directoryDelete( systemModulesPath, true );
		}
		directoryCreate( classesPath, true );
		directoryCreate( installerResourcesPath, true );
		directoryCreate( runtimeArtifactsPath, true );
		progressableDownloader.download(
			installerURL,
			resolvePath( installerResourcesPath & "/boxlang-installer.zip" ),
			function( status ) {},
			function( redirectURL ) {}
		);
		if( !thin ) {
			directoryCreate( systemModulesPath & "/cfml", true );
			fileWrite( installerResourcesPath & "/boxlang-version", installerSnapshot ? "snapshot" : "latest" );
			progressableDownloader.download(
				boxLangURL,
				resolvePath( runtimeArtifactsPath & "/boxlang.zip" ),
				function( status ) {},
				function( redirectURL ) {}
			);
			progressableDownloader.download(
				miniServerURL,
				resolvePath( runtimeArtifactsPath & "/boxlang-miniserver.zip" ),
				function( status ) {},
				function( redirectURL ) {}
			);
			bx:zip action="unzip" file="#runtimeArtifactsPath#/boxlang.zip" destination="#runtimeArtifactsPath#/boxlang" overwrite="true";
			bx:zip action="unzip" file="#runtimeArtifactsPath#/boxlang-miniserver.zip" destination="#runtimeArtifactsPath#/miniserver" overwrite="true";
			var boxLangJar = directoryList( runtimeArtifactsPath & "/boxlang/lib", false, "path", "*.jar" )[ 1 ];
			var miniServerJar = directoryList( runtimeArtifactsPath & "/miniserver/lib", false, "path", "*.jar" )[ 1 ];
			fileCopy( boxLangJar, installerResourcesPath & "/boxlang.jar", true );
			fileCopy( miniServerJar, installerResourcesPath & "/boxlang-miniserver.jar", true );

			var bxCliBoxJSON = packageService.readPackageDescriptor( resolvePath( "bx-cli" ) );
			var bxCliVersion = bxCliBoxJSON.version;
			var apiURL = "https://forgebox.io/api/v1/storage/bx-cli/#bxCliVersion#";
			bx:http url="#apiURL#" result="local.apiResult";
			var apiJSON    = JSONdeserialize( local.apiResult.fileContent );
			var downloadURL = apiJSON.data ?: throw( "Missing data in ForgeBox API response- [#apiJSON.tostring()#]" );
			progressableDownloader.download(
				downloadURL,
				resolvePath( installerResourcesPath & "/bx-cli.zip" ),
				function( status ) {},
				function( redirectURL ) {}
			);
			var originalDirectory = getCWD();
			command( "cd" ).params( systemModulesPath & "/cfml" ).run();
			try {
				command( "install" )
					.params(
						ID="commandbox-update-check,commandbox-cfconfig,commandbox-dotenv,contentbox-cli,coldbox-cli,testbox-cli,commandbox-boxlang,commandbox-bullet-train",
						directory=systemModulesPath & "/cfml/modules"
					)
					.run();
			} finally {
				command( "cd" ).params( originalDirectory ).run();
			}
			bx:zip
				action="zip"
				source="#systemModulesPath#/cfml"
				file="#installerResourcesPath#/commandbox-system-modules.zip"
				recurse="true"
				overwrite="true";
		}

		compile()
			.projectRoot( resolvePath( "build/temp/cli-bootstrap" ) )
			.fromSource( resolvePath( "build/src/cli-bootstrap/java/cliloader" ) )
			.toClasses( classesPath )
			.libsDir( "." )
			.withResources( installerResourcesPath )
			.jarOptions( { "mainClass" : "cliloader.CommandBoxCLIMain" } )
			.toJar( "box.jar" )
			.run();
		fileCopy( resolvePath( "build/temp/cli-bootstrap/box.jar" ), jarPath, true );

		print.greenLine( "Created #jarPath#" );
	}

	/**
	 * Builds the Unix launcher by appending the CLI JAR to the standard shell wrapper.
	 */
	function buildCliBinary( string artifactName="box" ) depends="buildCliJar" {
		var jarPath = resolvePath( "build/dist/#artifactName#.jar" );
		var binaryPath = resolvePath( "build/dist/#artifactName#" );

		if( !fileExists( jarPath ) ) {
			throw( message="The CLI launcher JAR does not exist. Run buildCliJar first.", type="commandException" );
		}

		fileCopy( resolvePath( "src/bin/box.sh" ), binaryPath );
		appendBinaryFile( binaryPath, jarPath );
		if( !System.getProperty( "os.name" ).toLowerCase().contains( "windows" ) ) {
			fileSetAccessMode( binaryPath, "755" );
		}

		print.greenLine( "Created #binaryPath#" );
	}

	/**
	 * Builds the Windows executable wrapper around the CLI launcher JAR.
	 */
	function buildCliExe( string artifactName="box" ) {
		var boxJSON = packageService.readPackageDescriptor( resolvePath( "bx-cli" ) );
		var jarPath = resolvePath( "build/dist/#artifactName#.jar" );
		var executablePath = resolvePath( "build/dist/#artifactName#.exe" );
		var launch4jPath = resolvePath( "build/launch4j-3.50/launch4j/launch4jc.exe" );
		var configPath = resolvePath( "build/temp/cli-bootstrap/#artifactName#-launch4j.xml" );
		var configTemplatePath = resolvePath( "build/box-launch4j.xml" );
		var buildNumber = reReplace( fileRead( resolvePath( "build/build.number" ) ), "(?s).*build.number=([0-9]+).*", "\1" );
		var numericVersion = reReplace( boxJSON.version, "[^0-9.].*$", "", "all" );
		var fileVersion = numericVersion & ".0";
		var textVersion = boxJSON.version & "." & buildNumber;

		if( !fileExists( jarPath ) ) {
			throw( message="The CLI launcher JAR does not exist. Run buildCliJar first.", type="commandException" );
		}
		if( !fileExists( launch4jPath ) ) {
			throw( message="The Launch4j compiler does not exist.", detail=launch4jPath, type="commandException" );
		}
		if( !fileExists( configTemplatePath ) ) {
			throw( message="The Launch4j configuration template does not exist.", detail=configTemplatePath, type="commandException" );
		}

		var configTemplate = fileRead( configTemplatePath );
		configTemplate = replace( configTemplate, "@EXECUTABLE_PATH@", xmlFormat( executablePath ), "all" );
		configTemplate = replace( configTemplate, "@JAR_PATH@", xmlFormat( jarPath ), "all" );
		configTemplate = replace( configTemplate, "@FILE_VERSION@", fileVersion, "all" );
		configTemplate = replace( configTemplate, "@TEXT_VERSION@", textVersion, "all" );
		configTemplate = replace( configTemplate, "@PRODUCT_VERSION@", fileVersion, "all" );
		configTemplate = replace( configTemplate, "@TEXT_PRODUCT_VERSION@", textVersion, "all" );
		fileWrite( configPath, configTemplate );

		systemExecute( '"' & launch4jPath & '" "' & configPath & '"' );

		print.greenLine( "Created #executablePath#" );
	}

	/**
	 * Builds the bundled CommandBox Linux RPM with Redline.
	 */
	function buildCliRpm() {
		var boxJSON = packageService.readPackageDescriptor( resolvePath( "bx-cli" ) );
		var version = reReplace( boxJSON.version, "^([0-9]+\.[0-9]+\.[0-9]+).*$", "\1" );
		var sourcePath = resolvePath( "build/dist/box" );
		var rpmPath = resolvePath( "build/dist/commandbox-rpm-#version#.rpm" );
		var redlineURL = "https://s3.amazonaws.com/downloads.ortussolutions.com/ortussolutions/redline/1.2.12/redline-1.2.12.jar";
		var redlineInstallPath = resolvePath( "build/temp/redline" );
		var redlineJar = redlineInstallPath & "/redline-1.2.12/redline-1.2.12.jar";
		var rpmLibsPath = resolvePath( "build/temp/rpm-libs" );
		var packager = "ortussolutions.com info@ortussolutions.com";
		var supportURL = "https://www.ortussolutions.com/services/support";
		var signingKeyring = getSystemSetting( "ORTUS_SIGN_KEYRING", "" );
		var signingKeyId = getSystemSetting( "ORTUS_SIGN_KEY_ID", "" );
		var signingKeyPassphrase = getSystemSetting( "ORTUS_SIGN_KEY_PASSPHRASE", "" );

		if( !fileExists( sourcePath ) ) {
			throw( message="The bundled Unix launcher does not exist. Run buildCliBinary first.", type="commandException" );
		}
		if( directoryExists( redlineInstallPath ) ) {
			directoryDelete( redlineInstallPath, true );
		}
		directoryCreate( redlineInstallPath, true );
		command( "install" )
			.params( ID="jar:#redlineURL#", directory=redlineInstallPath, save=false, force=true )
			.run();
		if( directoryExists( rpmLibsPath ) ) {
			directoryDelete( rpmLibsPath, true );
		}
		directoryCreate( rpmLibsPath, true );
		command( "install" )
			.params(
				ID="maven:org.apache.commons:commons-compress:1.21,maven:org.tukaani:xz:1.4,maven:org.bouncycastle:bcpg-jdk15on:1.50",
				directory=rpmLibsPath,
				save=false
			)
			.run();

		classLoad( [ redlineJar, rpmLibsPath ] );
		var builder = createObject( "java", "org.redline_rpm.Builder" ).init();
		builder.setPackage( "commandbox", version, "1" );
		builder.setPlatform(
			createObject( "java", "org.redline_rpm.header.Architecture" ).NOARCH,
			createObject( "java", "org.redline_rpm.header.Os" ).LINUX
		);
		builder.setSummary( "CommandBox CLI for BoxLang" );
		builder.setDescription( "CommandBox CLI, package manager, server manager, and REPL." );
		builder.setGroup( "com.ortussolutions" );
		builder.setPackager( packager );
		builder.setUrl( supportURL );
		builder.addFile( "/usr/bin/box", createObject( "java", "java.io.File" ).init( sourcePath ), 0755, 0755, "root", "root" );

		if( len( signingKeyring ) && len( signingKeyId ) && len( signingKeyPassphrase ) ) {
			builder.setPrivateKeyRingFile( createObject( "java", "java.io.File" ).init( signingKeyring ) );
			builder.setPrivateKeyId( signingKeyId );
			builder.setPrivateKeyPassphrase( signingKeyPassphrase );
		}

		builder.build( createObject( "java", "java.io.File" ).init( getDirectoryFromPath( rpmPath ) ) );
		fileMove( getDirectoryFromPath( rpmPath ) & "commandbox-#version#-1.noarch.rpm", rpmPath );

		print.greenLine( "Created #rpmPath#" );
	}

	/**
	 * Builds the bundled CommandBox Debian package with dpkg-deb in Docker.
	 */
	function buildCliDeb() depends="buildCliBinary" {
		var boxJSON = packageService.readPackageDescriptor( resolvePath( "bx-cli" ) );
		var sourcePath = resolvePath( "build/dist/box" );
		var packagePath = resolvePath( "build/temp/deb-package" );
		var debPath = resolvePath( "build/dist/commandbox-debian-#boxJSON.version#.deb" );
		var dockerPackagePath = replace( packagePath, "\\", "/", "all" );
		var dockerDistPath = replace( resolvePath( "build/dist" ), "\\", "/", "all" );
		var newLine = System.lineSeparator();

		if( directoryExists( packagePath ) ) {
			directoryDelete( packagePath, true );
		}
		directoryCreate( packagePath & "/DEBIAN", true );
		directoryCreate( packagePath & "/usr/local/bin", true );
		fileCopy( sourcePath, packagePath & "/usr/local/bin/box", true );
		fileWrite(
			packagePath & "/DEBIAN/control",
			"Package: commandbox#newLine#"
			& "Version: #boxJSON.version#-1#newLine#"
			& "Section: web#newLine#"
			& "Priority: extra#newLine#"
			& "Architecture: all#newLine#"
			& "Depends: java-common#newLine#"
			& "Maintainer: ortussolutions.com <info@ortussolutions.com>#newLine#"
			& "Description: CommandBox is a ColdFusion (CFML) CLI, Package Manager, Server and REPL.#newLine#"
			& " CommandBox Version: #boxJSON.version#.#newLine#"
		);
		command( "run" ).params(
			'docker run --rm -v "#dockerPackagePath#:/package" -v "#dockerDistPath#:/output" '
			& 'debian:bookworm-slim sh -c "chmod 755 /package/DEBIAN /package/usr /package/usr/local /package/usr/local/bin /package/usr/local/bin/box && chmod 644 /package/DEBIAN/control && dpkg-deb --build /package /output/commandbox-debian-#boxJSON.version#.deb"'
		).run();

		print.greenLine( "Created #debPath#" );
	}

	/**
	 * Stages Debian repository metadata and the current package for one repository.
	 */
	private function updateDebRepository(
		required string repoS3Path,
		required string repoPath,
		required string debPath,
		required string packageVersion,
		string signingKeyring="",
		string signingKeyId="",
		string signingKeyPassphrase=""
	) {
		var stagingPath = resolvePath( arguments.repoPath );
		var packageFileName = "commandbox_#arguments.packageVersion#-1_all.deb";
		var changesFileName = "commandbox_#arguments.packageVersion#-1_all.changes";
		var changesDate = dateTimeFormat( now(), "ddd, dd mmm yyyy HH:mm:ss" ) & " +0000";
		var passphrasePath = resolvePath( "build/temp/deb-signing-passphrase" );
		var dockerRepoPath = replace( stagingPath, "\\", "/", "all" );
		var dockerKeyringPath = replace( arguments.signingKeyring, "\\", "/", "all" );
		var dockerPassphrasePath = replace( passphrasePath, "\\", "/", "all" );
		var signingDockerArgs = "";
		var canSign = len( arguments.signingKeyring )
			&& len( arguments.signingKeyId )
			&& len( arguments.signingKeyPassphrase )
			&& fileExists( arguments.signingKeyring );
		var signingEnabled = canSign ? "1" : "0";

		if( directoryExists( stagingPath ) ) {
			directoryDelete( stagingPath, true );
		}
		directoryCreate( stagingPath, true );
		command( "run" ).params(
			'docker run --rm -v "#dockerRepoPath#:/repo" amazon/aws-cli:latest '
			& 's3 sync --no-sign-request "#arguments.repoS3Path#" /repo '
			& '--exclude "*" --include "Packages" --include "Packages.gz" '
			& '--include "Release" --include "Release.gpg" --include "InRelease"'
		).run();
		fileCopy( arguments.debPath, stagingPath & "/" & packageFileName, true );

		if( canSign ) {
			fileWrite( passphrasePath, arguments.signingKeyPassphrase );
			signingDockerArgs = '-v "#dockerKeyringPath#:/signing/keyring:ro" '
				& '-v "#dockerPassphrasePath#:/signing/passphrase:ro" '
				& '-e SIGNING_KEY_ID="#arguments.signingKeyId#"';
		}

		command( "run" ).params(
			'docker run --rm -e SIGNING_ENABLED="#signingEnabled#" -v "#dockerRepoPath#:/repo" #signingDockerArgs# '
			& 'debian:bookworm-slim sh -c "'
			& 'set -eu; apt-get update -qq; apt-get install -y -qq dpkg-dev apt-utils gnupg >/dev/null; '
			& 'cd /repo; '
			& 'if [ ! -f Packages ]; then : > Packages; fi; '
			& 'mkdir -p .new-package; cp #packageFileName# .new-package/; '
			& 'cd .new-package; dpkg-scanpackages . /dev/null > Packages.new; cd ..; cat .new-package/Packages.new >> Packages; '
			& 'package_size=$(stat -c %s #packageFileName#); package_sha256=$(sha256sum #packageFileName# | cut -d '' '' -f 1); package_sha512=$(sha512sum #packageFileName# | cut -d '' '' -f 1); '
			& 'printf ''Format: 1.8\nDate: #changesDate#\nSource: commandbox\nBinary: commandbox\nArchitecture: all\nVersion: #arguments.packageVersion#-1\nDistribution: unknown\nUrgency: low\nMaintainer: ortussolutions.com <info@ortussolutions.com>\nChanged-By: ortussolutions.com <info@ortussolutions.com>\nDescription:\n commandbox - CommandBox is a ColdFusion (CFML) CLI, Package Manager, Server and REPL\nChanges:\n commandbox (#arguments.packageVersion#-1) unknown; urgency=low\n\nChecksums-Sha256:\n %s %s %s\nChecksums-Sha512:\n %s %s %s\n'' "$package_sha256" "$package_size" "#packageFileName#" "$package_sha512" "$package_size" "#packageFileName#" > #changesFileName#.unsigned; '
			& 'gzip -9c Packages > Packages.gz; '
			& 'rm -rf .new-package; '
			& 'apt-ftparchive release . > Release.full; '
			& 'awk ''BEGIN { keep=1 } /^MD5Sum:$/ { keep=0 } /^SHA1:$/ { keep=0 } /^SHA256:$/ { keep=1 } { if ( keep ) print }'' Release.full > Release; '
			& 'rm -f Release.full; '
			& 'if [ "$SIGNING_ENABLED" = "1" ]; then gpg --batch --yes --pinentry-mode loopback --digest-algo SHA256 '
			& '--passphrase-file /signing/passphrase --no-default-keyring '
			& '--secret-keyring /signing/keyring --keyring /signing/keyring '
			& '--local-user "$SIGNING_KEY_ID" --clearsign --output #changesFileName# #changesFileName#.unsigned; '
			& 'gpg --batch --yes --pinentry-mode loopback --digest-algo SHA256 '
			& '--passphrase-file /signing/passphrase --no-default-keyring '
			& '--secret-keyring /signing/keyring --keyring /signing/keyring '
			& '--local-user "$SIGNING_KEY_ID" --detach-sign --output Release.gpg Release; '
			& 'rm -f #changesFileName#.unsigned; '
			& 'else mv #changesFileName#.unsigned #changesFileName#; rm -f Release.gpg InRelease; fi"'
		).run();

		if( fileExists( passphrasePath ) ) {
			fileDelete( passphrasePath );
		}
		print.greenLine( "Updated staged Debian repository #stagingPath#" );
	}

	/**
	 * Builds the Debian package and stages BE, plus stable when the version is stable.
	 */
	function updateDebRepo(
		string repoS3Path="s3://downloads.ortussolutions.com/debs-be/noarch/",
		string repoPath="build/dist/debs-be/noarch",
		string stableRepoS3Path="s3://downloads.ortussolutions.com/debs/noarch/",
		string stableRepoPath="build/dist/debs/noarch"
	) depends="buildCliDeb" {
		var boxJSON = packageService.readPackageDescriptor( resolvePath( "bx-cli" ) );
		var debPath = resolvePath( "build/dist/commandbox-debian-#boxJSON.version#.deb" );
		var signingKeyring = getSystemSetting( "ORTUS_SIGN_KEYRING", "" );
		var signingKeyId = getSystemSetting( "ORTUS_SIGN_KEY_ID", "" );
		var signingKeyPassphrase = getSystemSetting( "ORTUS_SIGN_KEY_PASSPHRASE", "" );

		updateDebRepository(
			arguments.repoS3Path,
			arguments.repoPath,
			debPath,
			boxJSON.version,
			signingKeyring,
			signingKeyId,
			signingKeyPassphrase
		);

		if( !semanticVersion.isPreRelease( boxJSON.version ) ) {
			updateDebRepository(
				arguments.stableRepoS3Path,
				arguments.stableRepoPath,
				debPath,
				boxJSON.version,
				signingKeyring,
				signingKeyId,
				signingKeyPassphrase
			);
		}
	}

	/**
	 * Stages an RPM repository and updates its metadata for the current CommandBox RPM.
	 */
	function updateRpmRepo(
		string repoS3Path="s3://downloads.ortussolutions.com/RPMS-be/noarch/",
		string repoPath="build/dist/RPMS-be/noarch",
		string stableRepoS3Path="s3://downloads.ortussolutions.com/RPMS/noarch/",
		string stableRepoPath="build/dist/RPMS/noarch"
	) depends="buildCliRpm" {
		var boxJSON = packageService.readPackageDescriptor( resolvePath( "bx-cli" ) );
		var version = reReplace( boxJSON.version, "^([0-9]+\.[0-9]+\.[0-9]+).*$", "\1" );
		var rpmPath = resolvePath( "build/dist/commandbox-rpm-#version#.rpm" );
		updateRpmRepository( arguments.repoS3Path, arguments.repoPath, rpmPath );

		if( !semanticVersion.isPreRelease( boxJSON.version ) ) {
			updateRpmRepository( arguments.stableRepoS3Path, arguments.stableRepoPath, rpmPath );
		}
	}

	/**
	 * Stages one RPM repository and updates its metadata for the current CommandBox RPM.
	 */
	private function updateRpmRepository(
		required string repoS3Path,
		required string repoPath,
		required string rpmPath
	) {
		var stagingPath = resolvePath( arguments.repoPath );

		if( directoryExists( stagingPath ) ) {
			directoryDelete( stagingPath, true );
		}
		directoryCreate( stagingPath, true );

		var dockerRepoPath = replace( stagingPath, "\", "/", "all" );
		command( "run" ).params(
			'docker run --rm -v "#dockerRepoPath#:/repo" amazon/aws-cli:latest '
			& 's3 sync --no-sign-request "#arguments.repoS3Path#" /repo '
			& '--exclude "*" --include "repodata/*"'
		).run();
		fileCopy( rpmPath, stagingPath & "/" & getFileFromPath( rpmPath ), true );
		command( "run" ).params(
			'docker run --rm -v "#dockerRepoPath#:/repo" rockylinux:8 '
			& 'sh -c "dnf -qy install createrepo && createrepo --update --recycle-pkglist '
			& '--skip-stat --includepkg #getFileFromPath( rpmPath )# /repo"'
		).run();

		print.greenLine( "Updated staged RPM repository #stagingPath#" );
	}

	/**
	 * Builds bundled and thin CLI launcher JARs and both platform-specific installer binaries.
	 */
	function buildInstallers( boolean installerSnapshot=true ) {
		buildCliJar( installerSnapshot, false, "box" );
		buildCliBinary( "box" );
		buildCliExe( "box" );
		buildCliRpm();
		buildCliJar( installerSnapshot, true, "box-thin" );
		buildCliBinary( "box-thin" );
		buildCliExe( "box-thin" );
	}

	/**
	 * Runs the launcher installation and detection scenarios for the current platform.
	 * Windows scenarios run directly; Unix scenarios run inside Ubuntu and Alpine Docker containers.
	 */
	function testCliBootstrap() {
		buildCliJar();
		if( System.getProperty( "os.name" ).toLowerCase().contains( "windows" ) ) {
			buildCliExe();
			runTestProcess( [
				"powershell",
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				resolvePath( "build/test-cli-bootstrap-windows.ps1" )
			] );
			return;
		}

		buildCliBinary();
		runTestProcess( [ "sh", resolvePath( "build/test-cli-bootstrap-ubuntu.sh" ) ] );
		runTestProcess( [ "sh", resolvePath( "build/test-cli-bootstrap-alpine.sh" ) ] );
	}

	/**
	 * Ubuntu: default install location, no env overrides.
	 */
	function testCliBootstrapUbuntuDefault() depends="buildCliBinary" {
		linuxDockerTest(
			"Ubuntu default",
			"ubuntu:24.04",
			'apt-get update >/dev/null && '
			& 'apt-get install -y --no-install-recommends openjdk-21-jre-headless curl unzip jq >/dev/null && '
			& 'cp /mnt/box /usr/local/bin/box && chmod 755 /usr/local/bin/box && '
			& '/usr/local/bin/box -clidebug version && '
			& 'test -f /usr/local/boxlang/bin/boxlang && '
			& 'test -f /root/.CommandBox/cfml/box.json && '
			& 'test -d /root/.CommandBox/cfml/modules/commandbox-update-check'
		);
	}

	/**
	 * Ubuntu: custom BOXLANG_INSTALL_HOME set via environment variable.
	 */
	function testCliBootstrapUbuntuCustomHome() depends="buildCliBinary" {
		linuxDockerTest(
			"Ubuntu custom BOXLANG_INSTALL_HOME",
			"ubuntu:24.04",
			'apt-get update >/dev/null && '
			& 'apt-get install -y --no-install-recommends openjdk-21-jre-headless curl unzip jq >/dev/null && '
			& 'cp /mnt/box /usr/local/bin/box && chmod 755 /usr/local/bin/box && '
			& 'export BOXLANG_INSTALL_HOME=/tmp/custom-boxlang && rm -rf $BOXLANG_INSTALL_HOME && '
			& '/usr/local/bin/box -clidebug version && '
			& 'test -f /tmp/custom-boxlang/bin/boxlang'
		);
	}

	/**
	 * Ubuntu: pre-install BoxLang via BVM, then verify box detects the existing installation.
	 */
	function testCliBootstrapUbuntuPreinstall() depends="buildCliBinary" {
		linuxDockerTest(
			"Ubuntu pre-install",
			"ubuntu:24.04",
			'apt-get update >/dev/null && '
			& 'apt-get install -y --no-install-recommends openjdk-21-jre-headless curl unzip jq >/dev/null && '
			& 'cp /mnt/box /usr/local/bin/box && chmod 755 /usr/local/bin/box && '
			& 'curl -fsSL https://install-bvm.boxlang.io | bash && '
			& 'export PATH=/root/.bvm/bin:$PATH && '
			& 'export TERM=dumb && '
			& 'bvm install snapshot && '
			& '/usr/local/bin/box -clidebug version && '
			& 'test -f /root/.bvm/bin/boxlang'
		);
	}

	/**
	 * Alpine: default install location, no env overrides.
	 */
	function testCliBootstrapAlpine() depends="buildCliBinary" {
		linuxDockerTest(
			"Alpine default",
			"alpine:3.20",
			'apk add --no-cache openjdk21 curl unzip jq bash >/dev/null && '
			& 'cp /mnt/box /usr/local/bin/box && chmod 755 /usr/local/bin/box && '
			& '/usr/local/bin/box -clidebug version && '
			& 'test -f /usr/local/boxlang/bin/boxlang'
		);
	}

	/**
	 * Runs all Linux bootstrap tests via Docker.
	 */
	function testCliBootstrapLinux() depends="buildCliBinary" {
		testCliBootstrapUbuntuDefault();
		testCliBootstrapUbuntuCustomHome();
		testCliBootstrapUbuntuPreinstall();
		testCliBootstrapAlpine();
	}

	/**
	 * Helper that builds and runs a Docker-based Linux smoke test.
	 *
	 * @label Test label for log output.
	 * @image Docker image.
	 * @setup Inline shell commands that install dependencies, copy the launcher, and run the test.
	 */
	private function linuxDockerTest( required string label, required string image, required string setup ) {
		var boxPath       = replace( resolvePath( "build/dist/box" ), "\", "/", "all" );
		var artifactsPath = replace( resolvePath( expandPath( "~/.CommandBox/artifacts" ) ), "\", "/", "all" );

		command( "run" ).params(
			'docker run --rm '
			& '-v "#boxPath#:/mnt/box:ro" '
			& '-v "#artifactsPath#:/root/.CommandBox/artifacts" '
			& '#image# sh -c "echo [#label#] && #setup# && echo PASS: #label#"'
		).run();
	}

	/**
	 * Creates the build workbench and final distribution directories.
	 */
	private function ensureBuildDirectories() {
		if( !directoryExists( resolvePath( "build/dist" ) ) ) {
			directoryCreate( resolvePath( "build/dist" ), true );
		}
		if( !directoryExists( resolvePath( "build/temp" ) ) ) {
			directoryCreate( resolvePath( "build/temp" ), true );
		}
		if( !directoryExists( resolvePath( "build/temp/classes" ) ) ) {
			directoryCreate( resolvePath( "build/temp/classes" ), true );
		}
		if( !directoryExists( resolvePath( "build/temp/cli-bootstrap" ) ) ) {
			directoryCreate( resolvePath( "build/temp/cli-bootstrap" ), true );
		}
	}

	/**
	 * Appends the bytes from one file to another file.
	 *
	 * @param destination The file that receives the appended bytes.
	 * @param source The file whose bytes are appended.
	 */
	private function appendBinaryFile( required string destination, required string source ) {
		var destinationPath = resolvePath( arguments.destination );
		var sourcePath = resolvePath( arguments.source );
		var outputStream = new FileOutputStream( destinationPath, true );

		try {
			outputStream.write( Files.readAllBytes( Paths.get( sourcePath ) ) );
		} finally {
			outputStream.close();
		}
	}
}
