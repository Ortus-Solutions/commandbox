import java.io.FileOutputStream;
import java.lang.System;
import java.nio.file.Files;
import java.nio.file.Paths;
import java.security.MessageDigest;

class {
	property name='packageService' inject='packageService';
	property name='semanticVersion' inject='provider:semanticVersion@semver';
	property name='progressableDownloader' inject='ProgressableDownloader';
	property name='artifactService' inject='ArtifactService';
	property name='fileSystemUtil' inject='FileSystem';

	// Config
	property name='launch4jVersion' default='3.50';
	property name='jsignVersion' default='7.5';
	property name='installerBaseURL' default='https://downloads.ortussolutions.com/ortussolutions/boxlang-quick-installer';

	/**
	 * Packages the bx-cli module and its supporting Java libraries.
	 */
	function run() {
		var boxJSON = packageService.readPackageDescriptor( resolvePath( "bx-cli" ) );
		var moduleSrcPath = resolvePath( "bx-cli/src/system" );
		var repoSrcPath = resolvePath( "src/cfml/system" );
		if( directoryExists( moduleSrcPath ) ) {
			directoryDelete( moduleSrcPath, true );
		}
		directoryCreate( moduleSrcPath );
		directoryCopy( repoSrcPath, moduleSrcPath, true );
		command( "tokenReplace" ).params( moduleSrcPath & "Shell.cfc", "@build.version@", boxJSON.version, true ).run();
		command( "tokenReplace" ).params( moduleSrcPath & "Bootstrap.cfm", "@build.version@", boxJSON.version, true ).run();

		var libsPath = resolvePath( "bx-cli/libs" );
		if( directoryExists( libsPath ) ) {
			directoryDelete( libsPath, true );
		}
		directoryCreate( libsPath );

		command( "install" )
			.params( "maven:org.jline:jline:3.21.0" )
			.inWorkingDirectory( resolvePath( "bx-cli" ) )
			.flags( "noSave", "force" )
			.run();

		command( "install" )
			.params( "maven:org.fusesource.jansi:jansi:2.4.1" )
			.inWorkingDirectory( resolvePath( "bx-cli" ) )
			.flags( "noSave", "force" )
			.run();

		command( "install" )
			.params( "maven:org.eclipse.jgit:org.eclipse.jgit:5.13.3.202401111512-r?exclude=org.slf4j:slf4j-api,org.apache.httpcomponents:httpclient" )
			.inWorkingDirectory( resolvePath( "bx-cli" ) )
			.flags( "noSave", "force" )
			.run();

		command( "install" )
			.params( "maven:org.eclipse.jgit:org.eclipse.jgit.ssh.jsch:5.13.3.202401111512-r?exclude=org.slf4j:slf4j-api,org.apache.httpcomponents:httpclient" )
			.inWorkingDirectory( resolvePath( "bx-cli" ) )
			.flags( "noSave", "force" )
			.run();

		command( "install" )
			.params( "maven:com.beust:jcommander:1.47" )
			.inWorkingDirectory( resolvePath( "bx-cli" ) )
			.flags( "noSave", "force" )
			.run();

		compile()
			.fromSource( "src/java/com" )
			.toClasses( "build/temp/classes/jgit" )
			.withClassPath( [ resolvePath( "bx-cli/libs" ) ] )
			.libsDir( "bx-cli/libs" )
			.toJar( "ortus-jgit.jar" )
			.run();

		command( "forgebox use" ).params( "ortus" ).run();
		command( "publish" ).inWorkingDirectory( resolvePath( "bx-cli" ) ).flags( "force" ).run();
	}

	/**
	 * Runs the full build: package the module, then build all installers.
	 */
	function all() {
		run();
		buildInstallers();
	}

	/**
	 * Builds the executable CLI launcher JAR.
	 *
	 * @thin Whether to build a thin launcher without bundled runtime resources.
	 * @artifactName The output artifact base name.
	 */
	function buildCliJar( boolean thin=false, string artifactName="box" ) {
		var classesPath = resolvePath( "build/temp/classes/cli-bootstrap" );
		var jarPath = resolvePath( "build/dist/#artifactName#.jar" );
		var installerResourcesPath = resolvePath( "build/temp/cli-bootstrap/installer" );
		var runtimeArtifactsPath = resolvePath( "build/temp/cli-bootstrap/runtime-artifacts" );
		var systemModulesPath = resolvePath( "build/temp/cli-bootstrap/system-modules" );
		// Swap this to false to use latest release resources instead of snapshot
		var installerSnapshot = true;
		var installerURLPrefix = installerSnapshot ? installerBaseURL & "/snapshot" : installerBaseURL;
		var installerURL = installerURLPrefix & "/boxlang-installer.zip";
		var boxLangURL = installerSnapshot
			? "https://downloads.ortussolutions.com/ortussolutions/boxlang/boxlang-snapshot.zip"
			: "https://downloads.ortussolutions.com/ortussolutions/boxlang/boxlang-latest.zip";
		var miniServerURL = installerSnapshot
			? "https://downloads.ortussolutions.com/ortussolutions/boxlang-runtimes/boxlang-miniserver/boxlang-miniserver-snapshot.zip"
			: "https://downloads.ortussolutions.com/ortussolutions/boxlang-runtimes/boxlang-miniserver/boxlang-miniserver-latest.zip";
		if( installerSnapshot ) {
			installerURL &= "?cacheBust=" & createUUID();
		}

		ensureBuildDirectories();
		if( directoryExists( classesPath ) ) {
			directoryDelete( classesPath, true );
		}
		if( directoryExists( installerResourcesPath ) ) {
			directoryDelete( installerResourcesPath, true );
		}
		if( directoryExists( runtimeArtifactsPath ) ) {
			directoryDelete( runtimeArtifactsPath, true );
		}
		directoryCreate( classesPath, true );
		directoryCreate( installerResourcesPath, true );
		directoryCreate( runtimeArtifactsPath, true );
		progressableDownloader.download(
			installerURL,
			resolvePath( installerResourcesPath & "/boxlang-installer.zip" ),
			function( status ) {},
			function( redirectURL ) {}
		);
		if( !thin ) {
			if( directoryExists( systemModulesPath ) ) {
				directoryDelete( systemModulesPath, true );
			}
			directoryCreate( systemModulesPath & "/cfml", true );
			fileWrite( installerResourcesPath & "/boxlang-version", installerSnapshot ? "snapshot" : "latest" );
			progressableDownloader.download(
				boxLangURL,
				resolvePath( runtimeArtifactsPath & "/boxlang.zip" ),
				function( status ) {},
				function( redirectURL ) {}
			);
			progressableDownloader.download(
				miniServerURL,
				resolvePath( runtimeArtifactsPath & "/boxlang-miniserver.zip" ),
				function( status ) {},
				function( redirectURL ) {}
			);
			bx:zip action="unzip" file="#runtimeArtifactsPath#/boxlang.zip" destination="#runtimeArtifactsPath#/boxlang" overwrite="true";
			bx:zip action="unzip" file="#runtimeArtifactsPath#/boxlang-miniserver.zip" destination="#runtimeArtifactsPath#/miniserver" overwrite="true";
			var boxLangJar = directoryList( runtimeArtifactsPath & "/boxlang/lib", false, "path", "*.jar" )[ 1 ];
			var miniServerJar = directoryList( runtimeArtifactsPath & "/miniserver/lib", false, "path", "*.jar" )[ 1 ];
			fileCopy( boxLangJar, installerResourcesPath & "/boxlang.jar", true );
			fileCopy( miniServerJar, installerResourcesPath & "/boxlang-miniserver.jar", true );

			var bxCliBoxJSON = packageService.readPackageDescriptor( resolvePath( "bx-cli" ) );
			var bxCliVersion = bxCliBoxJSON.version;
			var apiURL = "https://forgebox.io/api/v1/storage/bx-cli/#bxCliVersion#";
			bx:http url="#apiURL#" result="local.apiResult";
			var apiJSON    = JSONdeserialize( local.apiResult.fileContent );
			var downloadURL = apiJSON.data ?: throw( "Missing data in ForgeBox API response- [#apiJSON.tostring()#]" );
			progressableDownloader.download(
				downloadURL,
				resolvePath( installerResourcesPath & "/bx-cli.zip" ),
				function( status ) {},
				function( redirectURL ) {}
			);
			fileWrite( installerResourcesPath & "/bx-cli-version", bxCliVersion );
			var originalDirectory = getCWD();
			command( "cd" ).params( systemModulesPath & "/cfml" ).run();
			try {
				command( "install" )
					.params(
						ID="commandbox-update-check,commandbox-cfconfig,commandbox-dotenv,contentbox-cli,coldbox-cli,testbox-cli,commandbox-boxlang,commandbox-bullet-train",
						directory=systemModulesPath & "/cfml/modules"
					)
					.run();
			} finally {
				command( "cd" ).params( originalDirectory ).run();
			}
			bx:zip
				action="zip"
				source="#systemModulesPath#/cfml"
				file="#installerResourcesPath#/commandbox-system-modules.zip"
				recurse="true"
				overwrite="true";
		}

		compile()
			.projectRoot( resolvePath( "build/temp/cli-bootstrap" ) )
			.fromSource( resolvePath( "build/src/cli-bootstrap/java/cliloader" ) )
			.toClasses( classesPath )
			.libsDir( "." )
			.withResources( installerResourcesPath )
			.compileOptions( { "release" : 8 } )
			.jarOptions( { "mainClass" : "cliloader.CommandBoxCLIMain" } )
			.toJar( "box.jar" )
			.run();
		fileCopy( resolvePath( "build/temp/cli-bootstrap/box.jar" ), jarPath, true );
		createArtifactChecksums( jarPath );
		if( artifactName == "box-thin" ) {
			var lightJarPath = resolvePath( "build/dist/box-light.jar" );
			fileCopy( jarPath, lightJarPath, true );
			createArtifactChecksums( lightJarPath );
		}

		print.greenLine( "Created #jarPath#" );
	}

	/**
	 * Builds the bundled CLI launcher JAR with embedded runtime resources.
	 */
	function buildCliJarBundled() {
		buildCliJar( false, "box" );
	}

	/**
	 * Builds the thin CLI launcher JAR without embedded runtime resources.
	 */
	function buildCliJarThin() {
		buildCliJar( true, "box-thin" );
	}

	/**
	 * Builds the Unix launcher by appending the CLI JAR to the standard shell wrapper.
	 *
	 * For the thin launcher, use buildCliBinaryThin instead.
	 *
	 * @artifactName The output artifact base name.
	 */
	function buildCliBinary( string artifactName="box" ) depends="buildCliJarBundled" {
		var boxJSON = packageService.readPackageDescriptor( resolvePath( "bx-cli" ) );
		var jarPath = resolvePath( "build/dist/#artifactName#.jar" );
		var binaryPath = resolvePath( "build/dist/#artifactName#" );

		if( !fileExists( jarPath ) ) {
			throw( message="The CLI launcher JAR does not exist. Run buildCliJar first.", type="commandException" );
		}

		fileCopy( resolvePath( "src/bin/box.sh" ), binaryPath );
		appendBinaryFile( binaryPath, jarPath );
		if( !fileSystemUtil.isWindows() ) {
			fileSetAccessMode( binaryPath, "755" );
		}

		if( artifactName == "box" ) {
			var distributionPath = resolvePath( "build/dist" );
			var zipStagePath = resolvePath( "build/temp/distribution-zips" );
			var binStagePath = zipStagePath & "/bin";
			var sdkStagePath = zipStagePath & "/sdk/commandbox-#boxJSON.version#/bin";

			if( directoryExists( zipStagePath ) ) {
				directoryDelete( zipStagePath, true );
			}
			directoryCreate( binStagePath, true );
			directoryCreate( sdkStagePath, true );
			fileCopy( binaryPath, binStagePath & "/box", true );
			fileCopy( binaryPath, sdkStagePath & "/box", true );
			var binZipPath = distributionPath & "/commandbox-bin-#boxJSON.version#.zip";
			var sdkZipPath = distributionPath & "/commandbox-sdk-bin-#boxJSON.version#.zip";
			bx:zip action="zip" source="#binStagePath#" file="#binZipPath#" recurse="true" overwrite="true";
			createArtifactChecksums( binZipPath );
			bx:zip action="zip" source="#zipStagePath#/sdk" file="#sdkZipPath#" recurse="true" overwrite="true";
			createArtifactChecksums( sdkZipPath );
		}
		if( artifactName == "box-thin" ) {
			var lightBinaryPath = resolvePath( "build/dist/box-light" );
			fileCopy( binaryPath, lightBinaryPath, true );
			createArtifactChecksums( lightBinaryPath );
			if( !fileSystemUtil.isWindows() ) {
				fileSetAccessMode( lightBinaryPath, "755" );
			}
		}

		createArtifactChecksums( binaryPath );
		print.greenLine( "Created #binaryPath#" );
	}

	/**
	 * Builds the thin Unix launcher by appending the thin CLI JAR to the standard shell wrapper.
	 * Also produces the box-light copy.
	 */
	function buildCliBinaryThin() depends="buildCliJarThin" {
		buildCliBinary( "box-thin" );
	}

	/**
	 * Builds the Windows executable wrapper around the CLI launcher JAR.
	 *
	 * @artifactName The output artifact base name.
	 */
	function buildCliExe( string artifactName="box" ) {
		var boxJSON = packageService.readPackageDescriptor( resolvePath( "bx-cli" ) );
		var jarPath = resolvePath( "build/dist/#artifactName#.jar" );
		var executablePath = resolvePath( "build/dist/#artifactName#.exe" );
		var launch4jJarPath = "";
		var configPath = resolvePath( "build/temp/cli-bootstrap/#artifactName#-launch4j.xml" );
		var configTemplatePath = resolvePath( "build/box-launch4j.xml" );
		var buildNumber = reReplace( fileRead( resolvePath( "build/build.number" ) ), "(?s).*build.number=([0-9]+).*", "\1" );
		var numericVersion = reReplace( boxJSON.version, "[^0-9.].*$", "", "all" );
		var fileVersion = numericVersion & ".0";
		var textVersion = boxJSON.version & "." & buildNumber;

		if( !fileExists( jarPath ) ) {
			throw( message="The CLI launcher JAR does not exist. Run buildCliJar first.", type="commandException" );
		}
		if( !fileExists( configTemplatePath ) ) {
			throw( message="The Launch4j configuration template does not exist.", detail=configTemplatePath, type="commandException" );
		}
		ensureLaunch4j();
		launch4jJarPath = resolvePath( "build/launch4j-#launch4jVersion#/launch4j/launch4j.jar" );

		var configTemplate = fileRead( configTemplatePath );
		configTemplate = replace( configTemplate, "@EXECUTABLE_PATH@", xmlFormat( executablePath ), "all" );
		configTemplate = replace( configTemplate, "@JAR_PATH@", xmlFormat( jarPath ), "all" );
		configTemplate = replace( configTemplate, "@FILE_VERSION@", fileVersion, "all" );
		configTemplate = replace( configTemplate, "@TEXT_VERSION@", textVersion, "all" );
		configTemplate = replace( configTemplate, "@PRODUCT_VERSION@", fileVersion, "all" );
		configTemplate = replace( configTemplate, "@TEXT_PRODUCT_VERSION@", textVersion, "all" );
		fileWrite( configPath, configTemplate );
		systemExecute( "java", [ "-jar", launch4jJarPath, configPath ] );
		if( getSystemSetting( "SIGN_WINDOWS_EXE", true ) ) {
			signCliBinary( executablePath );
		}
		if( artifactName == "box" ) {
			var distributionPath = resolvePath( "build/dist" );
			var zipStagePath = resolvePath( "build/temp/distribution-zips/win" );
			var winZipPath = distributionPath & "/commandbox-win-#boxJSON.version#.zip";
			if( directoryExists( zipStagePath ) ) {
				directoryDelete( zipStagePath, true );
			}
			directoryCreate( zipStagePath, true );
			fileCopy( executablePath, zipStagePath & "/box.exe", true );
			bx:zip action="zip" source="#zipStagePath#" file="#winZipPath#" recurse="true" overwrite="true";
			createArtifactChecksums( winZipPath );
		}
		if( artifactName == "box-thin" ) {
			var lightExecutablePath = resolvePath( "build/dist/box-light.exe" );
			fileCopy( executablePath, lightExecutablePath, true );
			createArtifactChecksums( lightExecutablePath );
		}
		createArtifactChecksums( executablePath );

		print.greenLine( "Created #executablePath#" );
	}

	/**
	 * Ensures a full Launch4j distribution is available, downloading and extracting the
	 * archive for the current OS when missing. `launch4j.jar` and the `sign4j` tool are
	 * used directly from their extracted location.
	 */
	private function ensureLaunch4j() {
		var launch4jJarPath = resolvePath( "build/launch4j-#launch4jVersion#/launch4j/launch4j.jar" );
		if( fileExists( launch4jJarPath ) ) {
			return;
		}

		if( fileSystemUtil.isWindows() ) {
			var archiveFileName = "launch4j-#launch4jVersion#-win32.zip";
		} else if( fileSystemUtil.isMac() ) {
			var archiveFileName = "launch4j-#launch4jVersion#-macosx.tgz";
		} else {
			var archiveFileName = "launch4j-#launch4jVersion#-linux.tgz";
		}
		var launch4jRoot = resolvePath( "build/launch4j-#launch4jVersion#" );
		var archivePath = resolvePath( "build/temp/#archiveFileName#" );
		var archiveURL = "https://downloads.ortussolutions.com/launch4j/#launch4jVersion#/#archiveFileName#";

		directoryCreate( launch4jRoot, true );
		print.line( "Downloading Launch4j #launch4jVersion# (#archiveFileName#)..." ).toConsole();
		progressableDownloader.download(
			archiveURL,
			archivePath,
			function( status ) {},
			function( redirectURL ) {}
		);

		if( fileSystemUtil.isWindows() ) {
			bx:zip action="unzip" file="#archivePath#" destination="#launch4jRoot#" overwrite="true";
		} else {
			fileSystemUtil.extractTarGz( archivePath, launch4jRoot );
		}
		fileDelete( archivePath );

		if( !fileExists( launch4jJarPath ) ) {
			throw(
				message="Could not find launch4j.jar in downloaded Launch4j archive.",
				detail="Archive: #archiveFileName#",
				type="commandException"
			);
		}
		if( !fileSystemUtil.isWindows() ) {
			fileSetAccessMode( resolvePath( "build/launch4j-#launch4jVersion#/launch4j/bin/ld" ), "755" );
			fileSetAccessMode( resolvePath( "build/launch4j-#launch4jVersion#/launch4j/bin/windres" ), "755" );
			fileSetAccessMode( resolvePath( "build/launch4j-#launch4jVersion#/launch4j/sign4j/sign4j" ), "755" );
		}
	}

	/**
	 * Signs a Windows executable using Sign4j -> Jsign -> DigiCert KeyLocker.
	 *
	 * Signing is skipped silently when no credentials are configured, even if the
	 * caller requested signing.
	 *
	 * @binaryPath The executable path to sign.
	 */
	function signCliBinary( required string binaryPath ) {
		var digicertApiKey = getSystemSetting( "DIGICERT_API_KEY", "" );
		if( !len( digicertApiKey ) ) {
			print.line( "Skipping Windows binary signing: DIGICERT_API_KEY is not configured." ).toConsole();
			return;
		}

		var resolvedBinaryPath = resolvePath( arguments.binaryPath );
		var sign4jPath = resolvePath( "build/launch4j-#launch4jVersion#/launch4j/sign4j/sign4j" & ( fileSystemUtil.isWindows() ? ".exe" : "" ) );
		var defaultJsignPath = resolvePath( "build/temp/jsign/jsign-#jsignVersion#.jar" );
		var digicertClientCertificateBase64 = getSystemSetting( "DIGICERT_CLIENT_CERTIFICATE_BASE64", "" );
		var digicertClientCertificatePassword = getSystemSetting( "DIGICERT_CLIENT_CERTIFICATE_PASSWORD", "" );
		var digicertKeyAlias = getSystemSetting( "DIGICERT_KEY_ALIAS", "" );
		var temporaryClientCertificate = "";

		if( !fileExists( resolvedBinaryPath ) ) {
			throw( message="The executable to sign does not exist.", detail=resolvedBinaryPath, type="commandException" );
		}
		ensureLaunch4j();
		if( !fileExists( sign4jPath ) ) {
			throw(
				message="Sign4j executable was not found.",
				detail="Looked for: #sign4jPath#",
				type="commandException"
			);
		}

		if( !fileExists( defaultJsignPath ) ) {
			defaultJsignPath = provisionJsignBinary( defaultJsignPath );
		}
		temporaryClientCertificate = provisionDigiCertClientCertificate( digicertClientCertificateBase64 );
		var digicertStorePass = digicertApiKey & "|" & temporaryClientCertificate & "|" & digicertClientCertificatePassword;

		try {
			var signingResult = systemExecute( sign4jPath, [
				"--verbose",
				"java",
				"-jar",
				defaultJsignPath,
				"--storetype",
				"DIGICERTONE",
				"--storepass",
				digicertStorePass,
				"--alias",
				digicertKeyAlias,
				resolvedBinaryPath
			] );
			if( ( signingResult.exitCode ?: 0 ) != 0 ) {
				print.redLine( "Sign4j output: " & ( signingResult.output ?: "" ) ).toConsole();
				print.redLine( "Sign4j error: " & ( signingResult.error ?: "" ) ).toConsole();
				print.redLine( "Sign4j exit code: " & ( signingResult.exitCode ?: "unknown" ) ).toConsole();
				throw(
					message="Sign4j failed to sign the executable: #signingResult.error ?: signingResult.output ?: 'No signer output was returned.'#",
					type="commandException"
				);
			}
		} finally {
			if( len( temporaryClientCertificate ) && fileExists( temporaryClientCertificate ) ) {
				fileDelete( temporaryClientCertificate );
			}
		}
	}

	/**
	 * Decodes the DigiCert client certificate from an environment variable into a temporary Jsign keystore.
	 */
	private string function provisionDigiCertClientCertificate( required string certificateBase64 ) {
		var certificatePath = resolvePath( "build/temp/digicert-client-#createUUID()#.p12" );
		Files.write(
			Paths.get( certificatePath ),
			binaryDecode( reReplace( arguments.certificateBase64, "\s", "", "all" ), "base64" )
		);
		return certificatePath;
	}

	/**
	 * Downloads the current Jsign release used by the Sign4j DigiCert test path.
	 */
	private string function provisionJsignBinary( required string targetPath ) {
		var downloadDirectory = getDirectoryFromPath( arguments.targetPath );
		var downloadURL = "https://github.com/ebourg/jsign/releases/download/#jsignVersion#/jsign-#jsignVersion#.jar";

		directoryCreate( downloadDirectory, true, true );
		progressableDownloader.download( downloadURL, arguments.targetPath, function( status ) {}, function( redirectURL ) {} );
		if( !fileExists( arguments.targetPath ) ) {
			throw( message="Could not download Jsign.", detail=downloadURL, type="commandException" );
		}

		print.greenLine( "Provisioned Jsign: #arguments.targetPath#" );
		return arguments.targetPath;
	}

	/**
	 * Builds the bundled Java 21 JRE distributions for Linux, macOS, and Windows x64.
	 */
	function buildCliJREs() {
		var boxJSON = packageService.readPackageDescriptor( resolvePath( "bx-cli" ) );
		var distributionPath = resolvePath( "build/dist" );
		var workPath = resolvePath( "build/temp/jre" );
		var versionResult = {};
		var versionResponse = [];

		ensureBuildDirectories();
		if( !fileExists( resolvePath( "build/dist/box" ) ) || !fileExists( resolvePath( "build/dist/box.exe" ) ) ) {
			throw( message="The bundled CLI launchers do not exist. Run buildCliBinary and buildCliExe first.", type="commandException" );
		}

		bx:http
			url="https://api.bell-sw.com/v1/liberica/versions/21"
			result="versionResult";
		versionResponse = JSONDeserialize( versionResult.fileContent );
		var javaVersion = versionResponse
			.filter( function( entry ) { return entry.bundleTypes.find( "jre" ); } )
			.reduce( function( result, entry ) { return len( result ) ? result : entry.version; }, "" );
		if( !len( javaVersion ) ) {
			throw( "Liberica did not return a Java 21 version with a jre bundle. #versionResult.fileContent#" );
		}
		print.line( "Using Java Version: " & javaVersion ).toConsole();
		var platforms = [
			{
				name : "linux64",
				os : "linux",
				packageType : "tar.gz",
				launcher : "box",
				extension : "tar.gz"
			},
			{
				name : "darwin64",
				os : "macos",
				packageType : "zip",
				launcher : "box",
				extension : "zip"
			},
			{
				name : "win64",
				os : "windows",
				packageType : "zip",
				launcher : "box.exe",
				extension : "zip"
			}
		];

		platforms.each( function( platform ) {
			var releaseResult = {};
			var releaseResponse = [];
			var archivePath = workPath & "/" & platform.name & "." & platform.extension;
			var extractPath = workPath & "/" & platform.name & "/extract";
			var stagePath = workPath & "/" & platform.name & "/stage";
			var releaseURL = "https://api.bell-sw.com/v1/liberica/releases?version=#urlEncodedFormat( javaVersion )#&bitness=64&os=#platform.os#&arch=x86&package-type=#platform.packageType#&bundle-type=jre";

			if( directoryExists( workPath & "/" & platform.name ) ) {
				directoryDelete( workPath & "/" & platform.name, true );
			}
			directoryCreate( extractPath, true );
			directoryCreate( stagePath, true );
			print.line( "ReleaseURL: " & releaseURL ).toConsole();
			bx:http url="#releaseURL#" result="releaseResult";
			releaseResponse = JSONDeserialize( releaseResult.fileContent );
			var downloadURL = releaseResponse[ 1 ].downloadUrl ?: error( "Liberica did not return a #platform.name# Java 21 JRE download. #releaseResult.fileContent#" );
			progressableDownloader.download(
				downloadURL,
				archivePath,
				function( status ) {},
				function( redirectURL ) {}
			);

			if( platform.packageType == "tar.gz" ) {
				command( "run" ).params( 'tar -xzf "#archivePath#" -C "#extractPath#"' ).run();
			} else {
				bx:zip action="unzip" file="#archivePath#" destination="#extractPath#" overwrite="true";
			}
			var javaFiles = directoryList(
				path=extractPath,
				recurse=true,
				listInfo="path",
				filter=function( path ) {
					var fileName = getFileFromPath( path );
					return fileName == ( platform.os == "windows" ? "java.exe" : "java" );
				}
			);
			if( !javaFiles.len() ) {
				throw( "Liberica archive did not contain a Java executable for #platform.name#." );
			}

			var runtimePath = Paths.get( javaFiles[ 1 ] ).getParent().getParent().toString();
			directoryCopy( runtimePath, stagePath & "/jre", true );
			if( !directoryExists( stagePath & "/jre/bin" ) ) {
				throw( "Liberica runtime staging failed for #platform.name#: missing jre/bin." );
			}
			fileCopy( resolvePath( "build/dist/#platform.launcher#" ), stagePath & "/#platform.launcher#", true );
			if( !fileSystemUtil.isWindows() ) {
				fileSetAccessMode( stagePath & "/#platform.launcher#", "755" );
				fileSetAccessMode( stagePath & "/jre/bin/java", "755" );
			}

			var jreZipPath = distributionPath & "/commandbox-jre-#platform.name#-#boxJSON.version#.zip";
			bx:zip
				action="zip"
				source="#stagePath#"
				file="#jreZipPath#"
				recurse="true"
				overwrite="true";
			createArtifactChecksums( jreZipPath );
			print.greenLine( "Created commandbox-jre-#platform.name#-#boxJSON.version#.zip using Liberica #javaVersion#" );
		} );
	}

	/**
	 * Builds the bundled CommandBox Linux RPM with rpmbuild in Docker.
	 */
	function buildCliRpm() {
		var boxJSON = packageService.readPackageDescriptor( resolvePath( "bx-cli" ) );
		var version = reReplace( boxJSON.version, "^([0-9]+\.[0-9]+\.[0-9]+).*$", "\1" );
		var sourcePath = resolvePath( "build/dist/box" );
		var rpmPath = resolvePath( "build/dist/commandbox-rpm-#version#.rpm" );
		var rpmBuildPath = resolvePath( "build/temp/rpm-build" );
		var specPath = rpmBuildPath & "/SPECS/commandbox.spec";
		var packager = "ortussolutions.com info@ortussolutions.com";
		var supportURL = "https://www.ortussolutions.com/services/support";
		var signingKeyring = resolveSigningKeyring( getSystemSetting( "ORTUS_SIGN_KEYRING_BASE64", "" ) );
		var signingKeyId = getSystemSetting( "ORTUS_SIGN_KEY_ID", "" );
		var signingKeyPassphrase = getSystemSetting( "ORTUS_SIGN_KEY_PASSPHRASE", "" );
		var passphrasePath = resolvePath( "build/temp/rpm-signing-passphrase" );
		var dockerSourcePath = replace( sourcePath, "\\", "/", "all" );
		var dockerBuildPath = replace( rpmBuildPath, "\\", "/", "all" );
		var dockerOutputPath = replace( getDirectoryFromPath( rpmPath ), "\\", "/", "all" );
		var dockerKeyringPath = replace( signingKeyring, "\\", "/", "all" );
		var dockerPassphrasePath = replace( passphrasePath, "\\", "/", "all" );
		var signingDockerArgs = "";
		var newLine = System.lineSeparator();
		var canSign = len( signingKeyring )
			&& len( signingKeyId )
			&& len( signingKeyPassphrase )
			&& fileExists( signingKeyring );
		var signingEnabled = canSign ? "1" : "0";

		if( !fileExists( sourcePath ) ) {
			throw( message="The bundled Unix launcher does not exist. Run buildCliBinary first.", type="commandException" );
		}
		if( directoryExists( rpmBuildPath ) ) {
			directoryDelete( rpmBuildPath, true );
		}
		directoryCreate( rpmBuildPath & "/SPECS", true );
		fileWrite(
			specPath,
			"Name: commandbox#newLine#"
			& "Version: #version##newLine#"
			& "Release: 1#newLine#"
			& "Summary: CommandBox CLI for BoxLang#newLine#"
			& "License: Commercial#newLine#"
			& "Group: com.ortussolutions#newLine#"
			& "Packager: #packager##newLine#"
			& "URL: #supportURL##newLine#"
			& "BuildArch: noarch#newLine#"
			& "AutoReqProv: no#newLine#"
			& "Recommends: java-21-openjdk#newLine##newLine#"
			& "%description#newLine#"
			& "CommandBox CLI, package manager, server manager, and REPL.#newLine##newLine#"
			& "%install#newLine#"
			& "mkdir -p %{buildroot}/usr/bin#newLine#"
			& "install -m 0755 /input/box %{buildroot}/usr/bin/box#newLine##newLine#"
			& "%files#newLine#"
			& "%attr(0755,root,root) /usr/bin/box#newLine#"
		);

		if( canSign ) {
			fileWrite( passphrasePath, signingKeyPassphrase );
			signingDockerArgs = '-v "#dockerKeyringPath#:/signing/keyring:ro" '
				& '-v "#dockerPassphrasePath#:/signing/passphrase:ro" '
				& '-e SIGNING_KEY_ID="#signingKeyId#"';
		}

		var dockerRpmScript = "set -eu; "
			& "dnf -qy install rpm-build rpm-sign gnupg >/dev/null; "
			& 'sed -i ''s/\r$//'' /build/SPECS/commandbox.spec; '
			& 'rpmbuild --define ''_topdir /build'' -bb /build/SPECS/commandbox.spec; '
			& 'cp /build/RPMS/noarch/commandbox-#version#-1.noarch.rpm '
			& '/output/commandbox-rpm-#version#.rpm; '
			& 'if [ "#signingEnabled#" = "1" ]; then '
			& 'mkdir -m 700 /tmp/gnupg; export GNUPGHOME=/tmp/gnupg; '
			& 'gpg2 --batch --import /signing/keyring >/dev/null 2>&1; '
			& 'rpmsign --addsign '
			& '--define ''_gpg_name #signingKeyId#'' '
			& '--define ''_gpg_sign_cmd_extra_args --batch --pinentry-mode loopback --passphrase-file /signing/passphrase'' '
			& '/output/commandbox-rpm-#version#.rpm; fi';

		command( "run" ).params(
			'docker run --rm -v "#dockerSourcePath#:/input/box:ro" '
			& '-v "#dockerBuildPath#:/build" -v "#dockerOutputPath#:/output" #signingDockerArgs# '
			& 'rockylinux:8 sh -c "#dockerRpmScript#"'
		).run();
		createArtifactChecksums( rpmPath );

		if( fileExists( passphrasePath ) ) {
			fileDelete( passphrasePath );
		}
		if( signingKeyring == resolvePath( "build/temp/signing-keyring.gpg" ) && fileExists( signingKeyring ) ) {
			fileDelete( signingKeyring );
		}

		print.greenLine( "Created #rpmPath#" );
	}

	/**
	 * Builds the bundled CommandBox Debian package with dpkg-deb in Docker.
	 */
	function buildCliDeb() depends="buildCliBinary" {
		var boxJSON = packageService.readPackageDescriptor( resolvePath( "bx-cli" ) );
		var sourcePath = resolvePath( "build/dist/box" );
		var packagePath = resolvePath( "build/temp/deb-package" );
		var debPath = resolvePath( "build/dist/commandbox-debian-#boxJSON.version#.deb" );
		var dockerPackagePath = replace( packagePath, "\\", "/", "all" );
		var dockerDistPath = replace( resolvePath( "build/dist" ), "\\", "/", "all" );
		var newLine = System.lineSeparator();

		if( directoryExists( packagePath ) ) {
			directoryDelete( packagePath, true );
		}
		directoryCreate( packagePath & "/DEBIAN", true );
		directoryCreate( packagePath & "/usr/local/bin", true );
		fileCopy( sourcePath, packagePath & "/usr/local/bin/box", true );
		fileWrite(
			packagePath & "/DEBIAN/control",
			"Package: commandbox#newLine#"
			& "Version: #boxJSON.version#-1#newLine#"
			& "Section: web#newLine#"
			& "Priority: extra#newLine#"
			& "Architecture: all#newLine#"
			& "Depends: java-common#newLine#"
			& "Recommends: openjdk-21-jre#newLine#"
			& "Maintainer: ortussolutions.com <info@ortussolutions.com>#newLine#"
			& "Description: CommandBox is a ColdFusion (CFML) CLI, Package Manager, Server and REPL.#newLine#"
			& " CommandBox Version: #boxJSON.version#.#newLine#"
		);
		command( "run" ).params(
			'docker run --rm -v "#dockerPackagePath#:/package" -v "#dockerDistPath#:/output" '
			& 'debian:bookworm-slim sh -c "chmod 755 /package/DEBIAN /package/usr /package/usr/local /package/usr/local/bin /package/usr/local/bin/box && chmod 644 /package/DEBIAN/control && dpkg-deb --build /package /output/commandbox-debian-#boxJSON.version#.deb"'
		).run();
		createArtifactChecksums( debPath );

		print.greenLine( "Created #debPath#" );
	}

	/**
	 * Resolves a signing keyring path, decoding a base64 keyring to a temporary file when needed.
	 */
	private string function resolveSigningKeyring( string keyringBase64="" ) {
		if( !len( arguments.keyringBase64 ) ) {
			return "";
		}
		var temporaryKeyringPath = resolvePath( "build/temp/signing-keyring.gpg" );
		directoryCreate( getDirectoryFromPath( temporaryKeyringPath ), true, true );
		Files.write(
			Paths.get( temporaryKeyringPath ),
			binaryDecode( reReplace( arguments.keyringBase64, "\s", "", "all" ), "base64" )
		);
		return temporaryKeyringPath;
	}

	/**
	 * Writes the release checksum sidecars for a generated artifact.
	 *
	 * TODO: Once the next BoxLang release is available, remove the temporary
	 * MessageDigest implementation and uncomment the direct hash() version below.
	 */
	private function createArtifactChecksums( required string artifactPath ) {
		var artifactBytes = Files.readAllBytes( Paths.get( arguments.artifactPath ) );
		fileWrite( arguments.artifactPath & ".md5", calculateArtifactHash( artifactBytes, "MD5" ) );
		fileWrite( arguments.artifactPath & ".sha", calculateArtifactHash( artifactBytes, "SHA-1" ) );
		fileWrite( arguments.artifactPath & ".sha256", calculateArtifactHash( artifactBytes, "SHA-256" ) );

		/*
		var artifactBytes = fileReadBinary( arguments.artifactPath );
		fileWrite( arguments.artifactPath & ".md5", hash( artifactBytes, "MD5" ) );
		fileWrite( arguments.artifactPath & ".sha", hash( artifactBytes, "SHA-1" ) );
		fileWrite( arguments.artifactPath & ".sha256", hash( artifactBytes, "SHA-256" ) );
		*/
	}

	/**
	 * Temporary checksum implementation until the next BoxLang release.
	 */
	private string function calculateArtifactHash( required any artifactBytes, required string algorithm ) {
		var digest = MessageDigest.getInstance( arguments.algorithm );
		return lCase( binaryEncode( digest.digest( arguments.artifactBytes ), "hex" ) );
	}

	/**
	 * Stages Debian repository metadata and the current package for one repository.
	 *
	 * @repoS3Path The source S3 repository path.
	 * @repoPath The local repository staging path.
	 * @debPath The Debian package to add to the repository.
	 * @packageVersion The package version used in generated metadata.
	 * @signingKeyring The local temporary signing keyring path.
	 * @signingKeyId The signing key ID.
	 * @signingKeyPassphrase The signing key passphrase.
	 */
	private function updateDebRepository(
		required string repoS3Path,
		required string repoPath,
		required string debPath,
		required string packageVersion,
		string signingKeyring="",
		string signingKeyId="",
		string signingKeyPassphrase=""
	) {
		var stagingPath = resolvePath( arguments.repoPath );
		var packageFileName = "commandbox_#arguments.packageVersion#-1_all.deb";
		var changesFileName = "commandbox_#arguments.packageVersion#-1_all.changes";
		var changesDate = dateTimeFormat( now(), "ddd, dd mmm yyyy HH:mm:ss" ) & " +0000";
		var passphrasePath = resolvePath( "build/temp/deb-signing-passphrase" );
		var dockerRepoPath = replace( stagingPath, "\\", "/", "all" );
		var dockerKeyringPath = replace( arguments.signingKeyring, "\\", "/", "all" );
		var dockerPassphrasePath = replace( passphrasePath, "\\", "/", "all" );
		var signingDockerArgs = "";
		var canSign = len( arguments.signingKeyring )
			&& len( arguments.signingKeyId )
			&& len( arguments.signingKeyPassphrase )
			&& fileExists( arguments.signingKeyring );
		var signingEnabled = canSign ? "1" : "0";

		if( directoryExists( stagingPath ) ) {
			directoryDelete( stagingPath, true );
		}
		directoryCreate( stagingPath, true );
		command( "run" ).params(
			'docker run --rm -v "#dockerRepoPath#:/repo" amazon/aws-cli:latest '
			& 's3 sync --no-sign-request "#arguments.repoS3Path#" /repo '
			& '--exclude "*" --include "Packages" --include "Packages.gz" '
			& '--include "Release" --include "Release.gpg" --include "InRelease"'
		).run();
		fileCopy( arguments.debPath, stagingPath & "/" & packageFileName, true );

		if( canSign ) {
			fileWrite( passphrasePath, arguments.signingKeyPassphrase );
			signingDockerArgs = '-v "#dockerKeyringPath#:/signing/keyring:ro" '
				& '-v "#dockerPassphrasePath#:/signing/passphrase:ro" '
				& '-e SIGNING_KEY_ID="#arguments.signingKeyId#"';
		}

		command( "run" ).params(
			'docker run --rm -e SIGNING_ENABLED="#signingEnabled#" -v "#dockerRepoPath#:/repo" #signingDockerArgs# '
			& 'debian:bookworm-slim sh -c "'
			& 'set -eu; apt-get update -qq; apt-get install -y -qq dpkg-dev apt-utils gnupg >/dev/null; '
			& 'cd /repo; '
			& 'if [ ! -f Packages ]; then : > Packages; fi; '
			& 'mkdir -p .new-package; cp #packageFileName# .new-package/; '
			& 'cd .new-package; apt-ftparchive packages #packageFileName# > Packages.new; cd ..; '
			& 'perl -MDpkg::Control -e ''my ( $package, $version ) = @ARGV; '
			& 'open( my $input, q{<}, q{Packages} ) or die $!; '
			& 'open( my $output, q{>}, q{Packages.updated} ) or die $!; '
			& 'while( 1 ) { my $control = Dpkg::Control->new(); last unless $control->parse( $input ); '
			& 'next if $control->{Package} eq $package && $control->{Version} eq $version; '
			& '$control->output( $output ); print $output qq{\n}; }'' '
			& 'commandbox #arguments.packageVersion#-1; '
			& 'mv Packages.updated Packages; cat .new-package/Packages.new >> Packages; '
			& 'package_size=$(stat -c %s #packageFileName#); package_sha256=$(sha256sum #packageFileName# | cut -d '' '' -f 1); package_sha512=$(sha512sum #packageFileName# | cut -d '' '' -f 1); '
			& 'printf ''Format: 1.8\nDate: #changesDate#\nSource: commandbox\nBinary: commandbox\nArchitecture: all\nVersion: #arguments.packageVersion#-1\nDistribution: unknown\nUrgency: low\nMaintainer: ortussolutions.com <info@ortussolutions.com>\nChanged-By: ortussolutions.com <info@ortussolutions.com>\nDescription:\n commandbox - CommandBox is a ColdFusion (CFML) CLI, Package Manager, Server and REPL\nChanges:\n commandbox (#arguments.packageVersion#-1) unknown; urgency=low\n\nChecksums-Sha256:\n %s %s %s\nChecksums-Sha512:\n %s %s %s\n'' "$package_sha256" "$package_size" "#packageFileName#" "$package_sha512" "$package_size" "#packageFileName#" > #changesFileName#.unsigned; '
			& 'gzip -9c Packages > Packages.gz; '
			& 'rm -rf .new-package; '
			& 'apt-ftparchive release . > Release.full; '
			& 'awk ''BEGIN { keep=1 } /^MD5Sum:$/ { keep=0 } /^SHA1:$/ { keep=0 } /^SHA256:$/ { keep=1 } { if ( keep ) print }'' Release.full > Release; '
			& 'rm -f Release.full; '
			& 'if [ "$SIGNING_ENABLED" = "1" ]; then mkdir -m 700 /tmp/gnupg; export GNUPGHOME=/tmp/gnupg; '
			& 'gpg --batch --import /signing/keyring >/dev/null 2>&1; '
			& 'gpg --batch --yes --pinentry-mode loopback --digest-algo SHA256 '
			& '--passphrase-file /signing/passphrase '
			& '--local-user "$SIGNING_KEY_ID" --clearsign --output #changesFileName# #changesFileName#.unsigned; '
			& 'gpg --batch --yes --pinentry-mode loopback --digest-algo SHA256 '
			& '--passphrase-file /signing/passphrase '
			& '--local-user "$SIGNING_KEY_ID" --armor --detach-sign --output Release.gpg Release; '
			& 'rm -f #changesFileName#.unsigned; '
			& 'else mv #changesFileName#.unsigned #changesFileName#; rm -f Release.gpg InRelease; fi"'
		).run();

		if( fileExists( passphrasePath ) ) {
			fileDelete( passphrasePath );
		}
		print.greenLine( "Updated staged Debian repository #stagingPath#" );
	}

	/**
	 * Builds the Debian package and stages BE, plus stable when the version is stable.
	 *
	 * @repoS3Path The BE S3 repository path.
	 * @repoPath The local BE repository staging path.
	 * @stableRepoS3Path The stable S3 repository path.
	 * @stableRepoPath The local stable repository staging path.
	 */
	function updateDebRepo(
		string repoS3Path="s3://downloads.ortussolutions.com/debs-be/noarch/",
		string repoPath="build/dist/debs-be/noarch",
		string stableRepoS3Path="s3://downloads.ortussolutions.com/debs/noarch/",
		string stableRepoPath="build/dist/debs/noarch"
	) depends="buildCliDeb" {
		var boxJSON = packageService.readPackageDescriptor( resolvePath( "bx-cli" ) );
		var debPath = resolvePath( "build/dist/commandbox-debian-#boxJSON.version#.deb" );
		var signingKeyring = resolveSigningKeyring( getSystemSetting( "ORTUS_SIGN_KEYRING_BASE64", "" ) );
		var signingKeyId = getSystemSetting( "ORTUS_SIGN_KEY_ID", "" );
		var signingKeyPassphrase = getSystemSetting( "ORTUS_SIGN_KEY_PASSPHRASE", "" );

		updateDebRepository(
			arguments.repoS3Path,
			arguments.repoPath,
			debPath,
			boxJSON.version,
			signingKeyring,
			signingKeyId,
			signingKeyPassphrase
		);

		if( !semanticVersion.isPreRelease( boxJSON.version ) ) {
			updateDebRepository(
				arguments.stableRepoS3Path,
				arguments.stableRepoPath,
				debPath,
				boxJSON.version,
				signingKeyring,
				signingKeyId,
				signingKeyPassphrase
			);
		}

		var temporaryKeyringPath = resolvePath( "build/temp/signing-keyring.gpg" );
		if( signingKeyring == temporaryKeyringPath && fileExists( temporaryKeyringPath ) ) {
			fileDelete( temporaryKeyringPath );
		}
	}

	/**
	 * Stages an RPM repository and updates its metadata for the current CommandBox RPM.
	 */
	function updateRpmRepo(
		string repoS3Path="s3://downloads.ortussolutions.com/RPMS-be/noarch/",
		string repoPath="build/dist/RPMS-be/noarch",
		string stableRepoS3Path="s3://downloads.ortussolutions.com/RPMS/noarch/",
		string stableRepoPath="build/dist/RPMS/noarch"
	) depends="buildCliRpm" {
		var boxJSON = packageService.readPackageDescriptor( resolvePath( "bx-cli" ) );
		var version = reReplace( boxJSON.version, "^([0-9]+\.[0-9]+\.[0-9]+).*$", "\1" );
		var rpmPath = resolvePath( "build/dist/commandbox-rpm-#version#.rpm" );
		updateRpmRepository( arguments.repoS3Path, arguments.repoPath, rpmPath );

		if( !semanticVersion.isPreRelease( boxJSON.version ) ) {
			updateRpmRepository( arguments.stableRepoS3Path, arguments.stableRepoPath, rpmPath );
		}
	}

	/**
	 * Stages one RPM repository and updates its metadata for the current CommandBox RPM.
	 *
	 * @repoS3Path The source S3 repository path.
	 * @repoPath The local repository staging path.
	 * @rpmPath The RPM package to add to the repository.
	 */
	private function updateRpmRepository(
		required string repoS3Path,
		required string repoPath,
		required string rpmPath
	) {
		var stagingPath = resolvePath( arguments.repoPath );

		if( directoryExists( stagingPath ) ) {
			directoryDelete( stagingPath, true );
		}
		directoryCreate( stagingPath, true );

		var dockerRepoPath = replace( stagingPath, "\", "/", "all" );
		command( "run" ).params(
			'docker run --rm -v "#dockerRepoPath#:/repo" amazon/aws-cli:latest '
			& 's3 sync --no-sign-request "#arguments.repoS3Path#" /repo '
			& '--exclude "*" --include "repodata/*"'
		).run();
		fileCopy( rpmPath, stagingPath & "/" & getFileFromPath( rpmPath ), true );
		command( "run" ).params(
			'docker run --rm -v "#dockerRepoPath#:/repo" rockylinux:8 '
			& 'sh -c "dnf -qy install createrepo && createrepo --update --recycle-pkglist '
			& '--skip-stat --includepkg #getFileFromPath( rpmPath )# /repo"'
		).run();

		print.greenLine( "Updated staged RPM repository #stagingPath#" );
	}

	/**
	 * Builds bundled and thin CLI launcher JARs and both platform-specific installer binaries.
	 * Also builds the Debian package, stages the BE repositories, and stages stable
	 * repositories only when the package version is stable. Repository updates remain local.
	 */
	function buildInstallers() depends="cleanBuildDist" {
		// box.jar
		buildCliJarBundled();
		// *unix box
		buildCliBinary( "box" );
		// box.exe
		buildCliExe( "box" );
		// bundled Java 21 runtimes
		buildCliJREs();
		// API documentation
		buildApiDocs();

		// same as above, but "thin" versions
		buildCliJarThin();
		buildCliBinaryThin();
		// Build and sign box-thin.exe once; buildCliExe copies it to box-light.exe.
		buildCliExe( "box-thin" );

		// rpms
		buildCliRpm();
		updateRpmRepo();

		// debs
		buildCliDeb();
		updateDebRepo();
		syncDistToS3();
		syncApiDocsToS3();
	}

	/**
	 * Uploads the generated distribution files to the downloads S3 bucket.
	 *
	 * RPM and Debian artifacts remain at the bucket root so repository paths are stable. All other
	 * artifacts are uploaded below the versioned CommandBox release path.
	 */
	function syncDistToS3() {
		var accessKey = getSystemSetting( "AWS_ACCESS_KEY", "" );
		var accessSecret = getSystemSetting( "AWS_ACCESS_SECRET", "" );
		var distPath = resolvePath( "build/dist" );
		var version = packageService.readPackageDescriptor( resolvePath( "bx-cli" ) ).version;
		var bucketName = "downloads.ortussolutions.com";
		var versionPrefix = "ortussolutions/commandbox/#version#";
		var moduleRoot = resolvePath( "build/temp/s3sdk-task" );
		// API docs are uploaded to the apidocs bucket by the syncApiDocsToS3 task.
		var apidocsDistPath = resolvePath( "build/dist/apidocs" );

		if( !len( accessKey ) || !len( accessSecret ) ) {
			print.line( "Skipping S3 sync: AWS_ACCESS_KEY and AWS_ACCESS_SECRET are not configured." ).toConsole();
			return;
		}
		if( !directoryExists( distPath ) ) {
			throw( message="The distribution directory does not exist.", detail=distPath, type="commandException" );
		}
		installS3SDKModule( moduleRoot );
		var s3 = new s3sdk.models.AmazonS3(
			accessKey=accessKey,
			secretKey=accessSecret,
			awsRegion="us-east-1",
			autoContentType=true,
			defaultACL="public-read"
		);
		var artifactFiles = directoryList(
			path=distPath,
			recurse=true,
			listInfo="path",
			filter=function( path ) {
				return fileExists( path ) && left( path, len( apidocsDistPath ) ) != apidocsDistPath;
			}
		);

		artifactFiles.each( function( filePath ) {
			var relativePath = replaceNoCase( filePath, distPath, "", "one" );
			relativePath = reReplace( relativePath, "^[/\\\\]+", "", "all" );
			relativePath = replace( relativePath, "\", "/", "all" );
			var objectKey = isRootDistributionArtifact( relativePath )
				? relativePath
				: versionPrefix & "/" & relativePath;

			s3.putObjectFile(
				bucketName=bucketName,
				filepath=filePath,
				uri=objectKey,
				contentType="auto"
			);
			print.line( "Uploaded #objectKey#" ).toConsole();
		}, true );

		// After a successful upload, prune stale RPM repo metadata from S3.
		// The local repomd.xml references only the current generation; any other
		// file left in the local repodata folder is an orphan from a previous
		// build. Delete only those exact objects so the repo stops accumulating.
		var rpmRepositories = [ "RPMS-be/noarch", "RPMS/noarch" ];
		for( var repositoryPath in rpmRepositories ) {
			var localRepodataPath = resolvePath( "build/dist/#repositoryPath#/repodata" );
			var repomdFile = localRepodataPath & "/repomd.xml";
			if( !fileExists( repomdFile ) ) {
				continue;
			}

			// Extract the filenames referenced by the current repomd.xml
			var referencedFiles = [];
			var hrefMatches = reMatch( 'href="repodata/([^"]+)"', fileRead( repomdFile ) );
			for( var hrefMatch in hrefMatches ) {
				var referencedFile = reReplace( hrefMatch, 'href="repodata/([^"]+)"', "\1" );
				if( !referencedFiles.find( referencedFile ) ) {
					referencedFiles.append( referencedFile );
				}
			}

			// Delete any local repodata file that is not referenced, in parallel.
			// This runs only after the upload loop completes, so an upload error
			// can never wipe the repo before the new metadata is safely in place.
			var staleFiles = [];
			for( var localFile in directoryList( localRepodataPath, false, "name" ) ) {
				if( localFile != "repomd.xml" && !referencedFiles.find( localFile ) ) {
					staleFiles.append( localFile );
				}
			}
			staleFiles.each( function( localFile ) {
				var staleObjectKey = "#repositoryPath#/repodata/#localFile#";
				s3.deleteObject( bucketName=bucketName, uri=staleObjectKey );
				print.line( "Deleted stale S3 object #staleObjectKey#" ).toConsole();
			}, true );
		}
	}

	/**
	 * Uploads the unzipped API documentation to the apidocs S3 bucket.
	 *
	 * The generated HTML for the current version is uploaded below a versioned folder in the
	 * `commandbox` and `commandbox-core` doc sets. When the version is stable, a redirect
	 * `index.html` is also uploaded to the `current` folder of each doc set so the docs site
	 * can always point at the latest stable release.
	 */
	function syncApiDocsToS3() {
		var accessKey = getSystemSetting( "AWS_ACCESS_KEY", "" );
		var accessSecret = getSystemSetting( "AWS_ACCESS_SECRET", "" );
		var apidocsDistPath = resolvePath( "build/dist/apidocs" );
		var boxJSON = packageService.readPackageDescriptor( resolvePath( "bx-cli" ) );
		var version = boxJSON.version;
		var bucketName = "apidocs.ortussolutions.com";
		var moduleRoot = resolvePath( "build/temp/s3sdk-task" );
		var commandboxIndexTemplate = resolvePath( "build/resource/apidocs-commandbox-current-index.html" );
		var coreIndexTemplate = resolvePath( "build/resource/apidocs-commandbox-core-current-index.html" );

		if( !len( accessKey ) || !len( accessSecret ) ) {
			print.line( "Skipping API docs S3 sync: AWS_ACCESS_KEY and AWS_ACCESS_SECRET are not configured." ).toConsole();
			return;
		}
		if( !directoryExists( apidocsDistPath ) ) {
			throw( message="The API docs distribution directory does not exist.", detail=apidocsDistPath, type="commandException" );
		}
		installS3SDKModule( moduleRoot );
		var s3 = new s3sdk.models.AmazonS3(
			accessKey=accessKey,
			secretKey=accessSecret,
			awsRegion="us-east-1",
			autoContentType=true,
			defaultACL="public-read"
		);
		var artifactFiles = directoryList(
			path=apidocsDistPath,
			recurse=true,
			listInfo="path",
			filter=function( path ) {
				return fileExists( path );
			}
		);

		artifactFiles.each( function( filePath ) {
			var relativePath = replaceNoCase( filePath, apidocsDistPath, "", "one" );
			relativePath = reReplace( relativePath, "^[/\\\\]+", "", "all" );
			relativePath = replace( relativePath, "\", "/", "all" );
			s3.putObjectFile(
				bucketName=bucketName,
				filepath=filePath,
				uri=relativePath,
				contentType="auto"
			);
			print.line( "Uploaded #relativePath#" ).toConsole();
		}, true );

		if( semanticVersion.isPreRelease( version ) ) {
			print.line( "Skipping stable docs redirect: #version# is a pre-release." ).toConsole();
			return;
		}
		var redirectTargets = {
			"commandbox/current/index.html": commandboxIndexTemplate,
			"commandbox-core/current/index.html": coreIndexTemplate
		};
		for( var objectKey in redirectTargets ) {
			var templatePath = redirectTargets[ objectKey ];
			var redirectHTML = replace( fileRead( templatePath ), "@VERSION@", version, "all" );
			print.text( "Uploading #objectKey# ..." ).toConsole();
			s3.putObject(
				bucketName=bucketName,
				uri=objectKey,
				data=redirectHTML,
				contentType="text/html"
			);
			print.line( " Done!" ).toConsole();
		}
	}

	/**
	 * Installs and loads the S3 SDK into the ignored build workspace for the current task run.
	 */
	private function installS3SDKModule( required string moduleRoot ) {
		if( directoryExists( arguments.moduleRoot ) ) {
			directoryDelete( arguments.moduleRoot, true );
		}
		directoryCreate( arguments.moduleRoot, true );
		command( "install" )
			.params( ID="s3sdk", directory=arguments.moduleRoot )
			.flags( "force", "nosave" )
			.run();
		loadModule( arguments.moduleRoot & "/s3sdk" );
	}

	/**
	 * Determines whether an artifact belongs at the downloads bucket root.
	 *
	 * @relativePath The path relative to build/dist.
	 */
	private boolean function isRootDistributionArtifact( required string relativePath ) {
		var normalizedPath = replace( arguments.relativePath, "\", "/", "all" );
		var firstPathPart = lCase( listFirst( normalizedPath, "/" ) );
		return listFindNoCase( "RPMS,RPMS-be,debs,debs-be", firstPathPart ) > 0;
	}

	function buildApiDocs() {
		var boxJSON = packageService.readPackageDescriptor( resolvePath( "bx-cli" ) );
		var docsRoot = resolvePath( "build/temp/apidocs" );
		var commandDocsPath = docsRoot & "/CommandBox-CommandDocs";
		var coreDocsPath = docsRoot & "/CommandBox-APIDocs";
		var commandDocsZip = resolvePath( "build/dist/commandbox-apidocs-#boxJSON.version#.zip" );
		var coreDocsZip = resolvePath( "build/dist/commandbox-core-apidocs-#boxJSON.version#.zip" );
		var apidocsDistPath = resolvePath( "build/dist/apidocs" );
		var commandDocsDistPath = apidocsDistPath & "/commandbox/#boxJSON.version#";
		var coreDocsDistPath = apidocsDistPath & "/commandbox-core/#boxJSON.version#";
		var commandSources = {};
		var commandBasePath = resolvePath( "src/cfml" );
		var systemModulesBasePath = resolvePath( "build/temp/cli-bootstrap/system-modules/cfml/modules" );
		var commandDirs = directoryList(
			path=resolvePath( "src/cfml/system/modules_app" ),
			recurse=true,
			listInfo="path",
			filter=function( path ) {
				return reFindNoCase( ".*[/\\]commands$", arguments.path );
			}
		);

		if( directoryExists( docsRoot ) ) {
			directoryDelete( docsRoot, true );
		}
		directoryCreate( docsRoot, true );
		directoryCreate( commandDocsPath, true );
		installDocBoxModule();

		for( var commandDir in commandDirs ) {
			var relativeCommandPath = replaceNoCase( commandDir, commandBasePath, "", "one" );
			relativeCommandPath = reReplace( relativeCommandPath, "^[/\\]+", "", "all" );
			var mapping = "commandbox." & reReplace( relativeCommandPath, "[/\\]+", ".", "all" );
			commandSources[ mapping ] = commandDir;
		}
		if( directoryExists( systemModulesBasePath ) ) {
			var systemModuleCommandDirs = directoryList(
				path=systemModulesBasePath,
				recurse=true,
				listInfo="path",
				filter=function( path ) {
					return reFindNoCase( ".*[/\\]commands$", arguments.path );
				}
			);
			for( var commandDir in systemModuleCommandDirs ) {
				var relativeCommandPath = replaceNoCase( commandDir, systemModulesBasePath, "", "one" );
				relativeCommandPath = reReplace( relativeCommandPath, "^[/\\]+", "", "all" );
				var mapping = "commandbox.system.modules." & reReplace( relativeCommandPath, "[/\\]+", ".", "all" );
				commandSources[ mapping ] = commandDir;
			}
		}

		command( "docbox generate" )
			.params(
				argumentCollection={
					strategy="CommandBox",
					mappings=commandSources,
					"strategy-outputDir"=commandDocsPath,
					"strategy-projectTitle"="CommandBox v#boxJSON.version#",
					"strategy-theme"="default"
				}
			)
			.run();
		bx:zip action="zip" source="#commandDocsPath#" file="#commandDocsZip#" recurse="true" overwrite="true";
		createArtifactChecksums( commandDocsZip );
		directoryCopy( commandDocsPath, commandDocsDistPath, true );
		directoryDelete( docsRoot, true );
		directoryCreate( docsRoot, true );
		if( directoryExists( coreDocsPath ) ) {
			directoryDelete( coreDocsPath, true );
		}
		directoryCreate( coreDocsPath, true );

		command( "docbox generate" )
			.params(
				argumentCollection={
					source=resolvePath( "src/cfml/system" ),
					mapping="commandbox.system",
					excludes="system\\/(modules),system\\/(modules_app)",
					"strategy-outputDir"=coreDocsPath,
					"strategy-projectTitle"="CommandBox Internal v#boxJSON.version#"
				}
			)
			.run();
		bx:zip action="zip" source="#coreDocsPath#" file="#coreDocsZip#" recurse="true" overwrite="true";
		createArtifactChecksums( coreDocsZip );
		directoryCopy( coreDocsPath, coreDocsDistPath, true );

		print.greenLine( "Created #commandDocsZip#" );
		print.greenLine( "Created #coreDocsZip#" );
	}

	/**
	 * Installs and loads the DocBox CommandBox module into the ignored build workspace.
	 */
	private function installDocBoxModule() {
		var moduleRoot = resolvePath( "build/temp/docbox-task" );
		if( directoryExists( moduleRoot ) ) {
			directoryDelete( moduleRoot, true );
		}
		directoryCreate( moduleRoot, true );
		command( "install" )
			.params( ID="commandbox-docbox", directory=moduleRoot, save=false, force=true )
			.run();

		// TEMPORARY: remove once commandbox-docbox includes DocBox PR #33 commit 0f48bfe.
		// The core DocBox strategy dereferences linkData for empty $command structs.
		var strategyPath = moduleRoot & "/commandbox-docbox/docbox/strategy/AbstractTemplateStrategy.cfc";
		var strategySource = fileRead( strategyPath );
		var tab = char( 9 );
		var newLine = System.lineSeparator();
		var quote = char( 34 );
		var classKeyExpression = "$" & char( 35 ) & "arguments.classTerm" & char( 35 );
		var linkDataLine = tab & tab & tab & "var linkData = itemValue[ " & quote & classKeyExpression & quote & " ];";
		if( !find( linkDataLine, strategySource ) ) {
			throw(
				type="DocBoxStopgapNotApplicable",
				message="The DocBox AbstractTemplateStrategy linkData line was not found."
			);
		}
		strategySource = replace(
			strategySource,
			linkDataLine,
			tab & tab & tab & "if( structIsEmpty( itemValue[ " & quote & classKeyExpression & quote & " ] ) ){" & newLine
				& tab & tab & tab & tab & "continue;" & newLine
				& tab & tab & tab & "}" & newLine
				& linkDataLine,
			"one"
		);
		fileWrite( strategyPath, strategySource );
		var moduleService = wirebox.getInstance( "moduleService" );
		if( structKeyExists( moduleService.getModuleData(), "commandbox-docbox" ) ) {
			moduleService.unloadAndUnregisterModule( "commandbox-docbox" );
		}
		loadModule( moduleRoot & "/commandbox-docbox" );
		// END TEMPORARY DOCBOX STOPGAP.
	}

	/**
	 * Runs the launcher installation and detection scenarios for the current platform.
	 * Windows scenarios run directly; Unix scenarios run inside Ubuntu and Alpine Docker containers.
	 */
	function testCliBootstrap() {
		buildCliJar();
		if( fileSystemUtil.isWindows() ) {
			buildCliExe();
			runTestProcess( [
				"powershell",
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				resolvePath( "build/test-cli-bootstrap-windows.ps1" )
			] );
			return;
		}

		buildCliBinary();
		runTestProcess( [ "sh", resolvePath( "build/test-cli-bootstrap-ubuntu.sh" ) ] );
		runTestProcess( [ "sh", resolvePath( "build/test-cli-bootstrap-alpine.sh" ) ] );
	}

	/**
	 * Ubuntu: default install location, no env overrides.
	 */
	function testCliBootstrapUbuntuDefault() depends="buildCliBinary" {
		linuxDockerTest(
			"Ubuntu default",
			"ubuntu:24.04",
			'apt-get update >/dev/null && '
			& 'apt-get install -y --no-install-recommends openjdk-21-jre-headless curl unzip jq >/dev/null && '
			& 'cp /mnt/box /usr/local/bin/box && chmod 755 /usr/local/bin/box && '
			& '/usr/local/bin/box -clidebug version && '
			& 'test -f /usr/local/boxlang/bin/boxlang && '
			& 'test -f /root/.CommandBox/cfml/box.json && '
			& 'test -d /root/.CommandBox/cfml/modules/commandbox-update-check'
		);
	}

	/**
	 * Ubuntu: custom BOXLANG_INSTALL_HOME set via environment variable.
	 */
	function testCliBootstrapUbuntuCustomHome() depends="buildCliBinary" {
		linuxDockerTest(
			"Ubuntu custom BOXLANG_INSTALL_HOME",
			"ubuntu:24.04",
			'apt-get update >/dev/null && '
			& 'apt-get install -y --no-install-recommends openjdk-21-jre-headless curl unzip jq >/dev/null && '
			& 'cp /mnt/box /usr/local/bin/box && chmod 755 /usr/local/bin/box && '
			& 'export BOXLANG_INSTALL_HOME=/tmp/custom-boxlang && rm -rf $BOXLANG_INSTALL_HOME && '
			& '/usr/local/bin/box -clidebug version && '
			& 'test -f /tmp/custom-boxlang/bin/boxlang'
		);
	}

	/**
	 * Ubuntu: pre-install BoxLang via BVM, then verify box detects the existing installation.
	 */
	function testCliBootstrapUbuntuPreinstall() depends="buildCliBinary" {
		linuxDockerTest(
			"Ubuntu pre-install",
			"ubuntu:24.04",
			'apt-get update >/dev/null && '
			& 'apt-get install -y --no-install-recommends openjdk-21-jre-headless curl unzip jq >/dev/null && '
			& 'cp /mnt/box /usr/local/bin/box && chmod 755 /usr/local/bin/box && '
			& 'curl -fsSL https://install-bvm.boxlang.io | bash && '
			& 'export PATH=/root/.bvm/bin:$PATH && '
			& 'export TERM=dumb && '
			& 'bvm install snapshot && '
			& '/usr/local/bin/box -clidebug version && '
			& 'test -f /root/.bvm/bin/boxlang'
		);
	}

	/**
	 * Alpine: default install location, no env overrides.
	 */
	function testCliBootstrapAlpine() depends="buildCliBinary" {
		linuxDockerTest(
			"Alpine default",
			"alpine:3.20",
			'apk add --no-cache openjdk21 curl unzip jq bash >/dev/null && '
			& 'cp /mnt/box /usr/local/bin/box && chmod 755 /usr/local/bin/box && '
			& '/usr/local/bin/box -clidebug version && '
			& 'test -f /usr/local/boxlang/bin/boxlang'
		);
	}

	/**
	 * Runs all Linux bootstrap tests via Docker.
	 */
	function testCliBootstrapLinux() depends="buildCliBinary" {
		testCliBootstrapUbuntuDefault();
		testCliBootstrapUbuntuCustomHome();
		testCliBootstrapUbuntuPreinstall();
		testCliBootstrapAlpine();
	}

	/**
	 * Helper that builds and runs a Docker-based Linux smoke test.
	 *
	 * @label Test label for log output.
	 * @image Docker image.
	 * @setup Inline shell commands that install dependencies, copy the launcher, and run the test.
	 */
	private function linuxDockerTest( required string label, required string image, required string setup ) {
		var boxPath       = replace( resolvePath( "build/dist/box" ), "\", "/", "all" );
		var artifactsPath = replace( resolvePath( expandPath( "~/.CommandBox/artifacts" ) ), "\", "/", "all" );

		command( "run" ).params(
			'docker run --rm '
			& '-v "#boxPath#:/mnt/box:ro" '
			& '-v "#artifactsPath#:/root/.CommandBox/artifacts" '
			& '#image# sh -c "echo [#label#] && #setup# && echo PASS: #label#"'
		).run();
	}

	/**
	 * Creates the build workbench and final distribution directories.
	 */
	private function ensureBuildDirectories() {
		if( !directoryExists( resolvePath( "build/dist" ) ) ) {
			directoryCreate( resolvePath( "build/dist" ), true );
		}
		if( !directoryExists( resolvePath( "build/temp" ) ) ) {
			directoryCreate( resolvePath( "build/temp" ), true );
		}
		if( !directoryExists( resolvePath( "build/temp/classes" ) ) ) {
			directoryCreate( resolvePath( "build/temp/classes" ), true );
		}
		if( !directoryExists( resolvePath( "build/temp/cli-bootstrap" ) ) ) {
			directoryCreate( resolvePath( "build/temp/cli-bootstrap" ), true );
		}
	}

	/**
	 * Removes final distribution artifacts before a complete installer build.
	 */
	function cleanBuildDist() {
		var distributionPath = resolvePath( "build/dist" );
		if( directoryExists( distributionPath ) ) {
			directoryDelete( distributionPath, true );
		}
		directoryCreate( distributionPath, true );
	}

	/**
	 * Appends the bytes from one file to another file.
	 *
	 * @destination The file that receives the appended bytes.
	 * @source The file whose bytes are appended.
	 */
	private function appendBinaryFile( required string destination, required string source ) {
		var destinationPath = resolvePath( arguments.destination );
		var sourcePath = resolvePath( arguments.source );
		var outputStream = new FileOutputStream( destinationPath, true );

		try {
			outputStream.write( Files.readAllBytes( Paths.get( sourcePath ) ) );
		} finally {
			outputStream.close();
		}
	}
}
