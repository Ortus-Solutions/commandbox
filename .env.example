# Local RPM signing values. CI supplies the same names as environment variables.
ORTUS_SIGN_KEYRING_BASE64=
ORTUS_SIGN_KEY_ID=
ORTUS_SIGN_KEY_PASSPHRASE=
AWS_ACCESS_KEY=
AWS_ACCESS_SECRET=

# Windows exe signing values (Sign4j -> Jsign -> DigiCert KeyLocker)
SIGN_WINDOWS_EXE=true
DIGICERT_API_KEY=
DIGICERT_CLIENT_CERTIFICATE_BASE64=
DIGICERT_CLIENT_CERTIFICATE_PASSWORD=
DIGICERT_KEY_ALIAS=
