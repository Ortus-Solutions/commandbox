
import java.lang.System;
import java.nio.file.Paths;

class {

	function configure() {
		variables.settings = {
			// We're not looking for a commandbox.properties file in this module boostrap since there's no real file system convention
			// for where we'd look since direct module invocation doesn't use box.exe.  
			commandboxHome : getSystemSetting( "commandBox_home", System.getProperty( "user.home" ) & "/.CommandBox/" )
		};
	}

	function main( required Array args  ) {
		// Detect if invoked by the CommandBox installer bootstrap (checks env var OR system prop, case-insensitive)
		calledByInstaller = getSystemSetting( "COMMANDBOX_INSTALLER_BOOTSTRAP", "" ) == "true";

		// Always handle -clidebug flag (strip it from args regardless of bootstrap source)
		// Note: args is unmodifiable, so we must use filter() instead of deleteAt()
		if( args.find( "-clidebug" ) ) {
			debug = true;
			args = args.filter( function( arg ) { return arg != "-clidebug"; } );
		} else if( calledByInstaller ) {
			debug = getSystemSetting( "cfml.cli.debug", "false" ) == "true";
		} else {
			debug = false;
		}

		// Always handle -cliworkingdir flag (strip it from args regardless of bootstrap source)
		if( calledByInstaller ) {
			workingDir = getSystemSetting( "cfml.cli.pwd", getSystemSetting( "user.dir", "" ) );
		} else {
			workingDir = resolveWorkingDir( args );
		}
		// Strip -cliworkingdir from args in the caller's scope (filter inside resolveWorkingDir
		// only reassigns the function's local copy, so do it here where args is actually used)
		args = args.filter( function( arg ) {
			return ! arg.startsWith( "-cliworkingdir" );
		} );

		System.setProperty( "cfml.cli.debug", debug.toString() );
		System.setProperty( "cfml.cli.pwd", workingDir );

		// Only output bootstrap debug info when the Java bootstrap didn't already
		if( debug && !calledByInstaller ) {
			println( "[clidebug] Java Version: " & getSystemSetting( "java.version", "Unknown" ) );
			println( "[clidebug] Java Home: " & getSystemSetting( "java.home", "Unknown" ) );
			println( "[clidebug] BoxLang Home: " & boxRuntime.getRuntimeHome() );
			println( "[clidebug] CommandBox Home: " & variables.settings.commandboxHome );
			println( "[clidebug] Working Directory: " & workingDir );
			println( "[clidebug] Arguments: " & JSONSerialize( args ) );
		}

		moduleRoot = getDirectoryFromPath( getCurrentTemplatePath() );
		// Load up our dependencies
		boxRuntime.getModuleService().loadModules( Paths.get( moduleRoot, ["cli_modules"] ) );

		// When the Java bootstrap launched us in-process it registers its own shutdown hook that
		// interrupts the main thread, so don't add a second one here.
		if( !calledByInstaller ) {
			registerShutdownHook( debug );
		}

		server.unlock();
		boxAnnounce( "onServerScopeCreation", { scope : server } );

		commandboxHome = variables.settings.commandboxHome;

		// This needs to be the drive root where the CF bootstrap lives
		rootMapping = Paths.get( moduleRoot ).toAbsolutePath().getRoot().toString();
		bootstrap = "/" & Paths.get( moduleRoot, [ "src/system/Bootstrap.cfm" ] ).toAbsolutePath().toString().replace( rootMapping , "" ).replace( "\", "/", "all"	 );
		
		boxRuntime.getConfiguration().registerMapping( "/", rootMapping );
		boxRuntime.getConfiguration().registerMapping( "/bxcliRoot", moduleRoot );
		
		// TODO: rename cfml.cli.* to boxlang.cli.*
		System.setProperty( "cfml.cli.home", commandboxHome );
		System.setProperty( "cfml.cli.moduleRoot", moduleRoot );
		System.setProperty( "cfml.cli.arguments", args.toList( " " ) );
		System.setProperty( "cfml.cli.argument.array", JSONSerialize( args ) );

		if ( debug ) {
			println( "Root Mapping: " & rootMapping );
			println( "Bootstrap: " & bootstrap );
		}

		bootstrapSrc = "
			// loader = createObject( 'java', 'cliloader.LoaderCLIMain' );
			// if( !isNull( loader.FRTrans ) ) { loader.FRTrans.close(); }
			
			include '" & bootstrap.replace( "'", "''" ) & "';
		";

		if ( debug ) {
			println( "" );
			println( bootstrapSrc );
			println( "" );
		}

		try {
			// Kick off the box bootstrap
			boxRuntime.executeSource( bootstrapSrc );
			exitCode = val( System.getProperty( "cfml.cli.exitCode", "0" ) );
		} catch( any e ) {
			e.printStackTrace();
			exitCode = 1;
		}

		// SHIM: BoxLang cores older than 1.20 ignore a module main() return value, so we have to
		// set the process exit code ourselves before BoxRunner exits.  Remove this block once
		// core 1.20 is our minimum supported version-- the return below handles it on its own.
		if( exitCode != 0 ) {
			boxRuntime.shutdown();
			System.exit( exitCode );
		}

		// BoxRunner uses this as the process exit code
		return exitCode;
	}

	/**
	 * Registers a JVM shutdown hook that interrupts the main thread so CommandBox can stop
	 * anything it started (such as a server) before the process exits.
	 *
	 * This is what makes a Ctrl-C from a service manager (NSSM, systemd, etc.) stop the
	 * server.  There is no interactive terminal there, so JLine never registers its native
	 * signal handler and no keystroke is ever delivered-- the control event becomes a plain
	 * JVM shutdown instead.  Interrupting main lets the normal interrupt handling run.
	 */
	private function registerShutdownHook( required boolean debug ) {
		// main() runs on the main thread, so that's the one to interrupt
		mainThread = createObject( "java", "java.lang.Thread" ).currentThread();

		// The hook is a real Java object (compiled into ortus-java.jar in this module's
		// libs) rather than a BoxLang dynamic proxy.  The hook body runs after the BoxLang
		// runtime has been torn down, so a BoxLang implementation would have to bootstrap a
		// brand new runtime with default settings just to interrupt main.
		interruptor = createObject( "java", "com.ortussolutions.commandbox.cli.ShutdownInterruptor" ).init( mainThread, arguments.debug );

		hookThread = createObject( "java", "java.lang.Thread" ).init( interruptor, "CommandBox-ShutdownHook" );
		createObject( "java", "java.lang.Runtime" ).getRuntime().addShutdownHook( hookThread );
	}

	/**
	 * Resolves the working directory from args or defaults to user.dir.
	 * Supports -cliworkingdir=/path and -cliworkingdir /path forms.
	 * Removes the flag from args. Always returns with a trailing separator.
	 */
	private function resolveWorkingDir( required Array args ) {
		separator = getSystemSetting( "file.separator", "/" );
		// Use filter to strip -cliworkingdir (args may be unmodifiable)
		workingDir = "";
		for( arg in args ) {
			if( arg.startsWith( "-cliworkingdir" ) ) {
				if( arg.find( "=" ) ) {
					workingDir = arg.listLast( "=" );
				}
				// If no =, the next arg is the value (handled below the loop)
			}
		}
		args = args.filter( function( arg ) {
			return ! arg.startsWith( "-cliworkingdir" );
		} );
		// If we found -cliworkingdir with a space separator, grab the next arg that was the value
		// (filter already removed the flag, but the value arg might still be there)
		if( workingDir == "" ) {
			// Re-scan for space-separated form by checking if any arg looked like a path after a removed flag
			// The value would have been after -cliworkingdir in original args
			// Since we can't easily detect that, just use user.dir
			workingDir = getSystemSetting( "user.dir", "" );
		}
		if( ! workingDir.endsWith( separator ) && ! workingDir.endsWith( "/" ) ) {
			workingDir &= separator;
		}
		return workingDir;
	}
}