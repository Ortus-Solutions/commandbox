        "org.fusesource.jansi:jansi":"maven:org.fusesource.jansi:jansi:2.4.1",
        "org.eclipse.jgit:org.eclipse.jgit":"maven:org.eclipse.jgit:org.eclipse.jgit:5.13.3.202401111512-r?exclude=org.slf4j:slf4j-api,org.apache.httpcomponents:httpclient",
        "org.eclipse.jgit:org.eclipse.jgit.ssh.jsch":"maven:org.eclipse.jgit:org.eclipse.jgit.ssh.jsch:5.13.3.202401111512-r?exclude=org.slf4j:slf4j-api,org.apache.httpcomponents:httpclient",
        "com.beust:jcommander":"maven:com.beust:jcommander:1.47"
    },
    "maven":{
        "installMode":"shared",
        "installDirectory":"libs",
        "repositories":{
            "jgit":"https://repo.eclipse.org/content/groups/releases/"
