    "documentation":"https://commandbox.ortusbooks.com/",
    "repository":{
        "type":"git",
        "URL":"https://github.com/Ortus-Solutions/commandbox"
    },
    "slug":"bx-cli",
    "shortDescription":"CommandBox CLI for BoxLang",
    "type":"boxlang-modules",
    "private":false,
    "license":[
        {
            "type":"Apache-2.0",
            "URL":"https://www.apache.org/licenses/LICENSE-2.0"
