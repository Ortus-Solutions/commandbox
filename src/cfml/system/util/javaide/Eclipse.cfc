* www.coldbox.org | www.ortussolutions.com
********************************************************************************
* @author Brad Wood, Luis Majano
*
* I write Eclipse JDT metadata. The .classpath format takes explicit entries, so
* my JAR entries are a snapshot that must be regenerated after a dependency change.
*
*/
component extends="BaseEmitter" {

	boolean function detect( required string root ) {
		return fileExists( arguments.root & "/.project" ) || fileExists( arguments.root & "/.classpath" )
			|| directoryExists( arguments.root & "/.settings" );
	}

	array function files( required struct model ) {
		var entries = [];
		var roots = duplicate( arguments.model.sourceRoots );
		for( var root in arguments.model.resourceRoots ) {
			if( directoryExists( root ) && !roots.find( root ) ) roots.append( root );
		}
		for( var root in roots ) {
			var path = relative( root, arguments.model );
			entries.append( patch(
				"/classpath/classpathentry[@kind='src' and @path=#literal( path )#]",
				[ '<classpathentry kind="src" path="#escape( path )#"/>' ], "/classpath"
			) );
		}
		for( var classPathEntry in arguments.model.classPath ) {
			var base = relative( classPathEntry.path, arguments.model );
			var jars = [];
			for( var jar in classPathEntry.resolved ) {
				jars.append( '<classpathentry kind="lib" path="#escape( relative( jar, arguments.model ) )#"/>' );
			}
			// Replacing everything under a declared classPath entry is what removes
			// jars left behind by a dependency upgrade; entries elsewhere are untouched.
			entries.append( patch(
				classPathEntry.kind == "directory"
					? "/classpath/classpathentry[@kind='lib' and starts-with(@path,#literal( base & "/" )#)]"
					: "/classpath/classpathentry[@kind='lib' and @path=#literal( base )#]",
				jars,
				"/classpath"
			) );
		}
		entries.append( patch(
			"/classpath/classpathentry[@kind='output']",
			[ '<classpathentry kind="output" path="#escape( relative( arguments.model.outputDirectory, arguments.model ) )#"/>' ],
			"/classpath"
		) );
		var version = arguments.model.release;
		var environment = len( version ) ? ( val( version ) <= 8 ? "JavaSE-1.#version#" : "JavaSE-#version#" ) : "";
		entries.append( patch(
			"/classpath/classpathentry[@kind='con' and starts-with(@path,'org.eclipse.jdt.launching.JRE_CONTAINER')]",
			[ '<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER#len( environment ) ? "/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/" & environment : ""#"/>' ],
			"/classpath"
		) );
		var result = [
			{ "path" : ".classpath", "format" : "xml", "seed" : "<classpath/>", "patches" : entries },
			{
				"path" : ".project", "format" : "text", "seed" : "", "createOnly" : true,
				"patches" : [ patch( "project", [
					'<projectDescription><name>#escape( arguments.model.name )#</name><comment>Generated by java ide-init</comment><projects/><buildSpec><buildCommand><name>org.eclipse.jdt.core.javabuilder</name><arguments/></buildCommand></buildSpec><natures><nature>org.eclipse.jdt.core.javanature</nature></natures></projectDescription>'
				] ) ]
			}
		];
		var preferences = [ patch( "eclipse.preferences.version", [ "eclipse.preferences.version=1" ] ) ];
		if( len( version ) ) {
			version = val( version ) <= 8 ? "1.#version#" : version;
			for( var key in [ "compliance", "source", "codegen.targetPlatform" ] ) {
				preferences.append( patch(
					"org.eclipse.jdt.core.compiler.#key#", [ "org.eclipse.jdt.core.compiler.#key#=#version#" ]
				) );
			}
		}
		result.append( {
			"path" : ".settings/org.eclipse.jdt.core.prefs", "format" : "properties",
			"seed" : "", "patches" : preferences
		} );
		return result;
	}
}
